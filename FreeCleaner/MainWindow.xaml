                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Power Plan Switcher & Game Booster -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BgSecondaryBrush}"
