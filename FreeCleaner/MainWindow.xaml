                                <DataGridTextColumn Header="Açıklama / Uzantı Kimliği" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                                <DataGridTemplateColumn Header="Klasör" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Konumu Aç"
                                                    Padding="8,4"
                                                    Command="{Binding DataContext.OpenExtensionFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 20: WINDOWS UPDATES (HOTFIX KB) & DRIVERSTORE AUDITOR                -->
