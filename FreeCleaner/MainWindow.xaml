                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DİSK KLASÖR AĞACI:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SpaceTreeTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Width="195"
                                             Background="{StaticResource BgCardBrush}"
                                             Foreground="White"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Padding="6,4"
                                             Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Seç..."
                                            Command="{Binding BrowseSpaceTreeFolderCommand}"/>
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Analiz Et"
                                        Padding="12,5"
                                        HorizontalAlignment="Right"
                                        Command="{Binding AnalyzeFolderSpaceTreeCommand}"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FolderSpaceItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCardBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    Margin="0,0,4,7">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" FontSize="12.5"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding PercentageOfParent, Mode=OneWay}"
                                                                 Maximum="100"
                                                                 Height="6"
                                                                 Margin="0,6,0,2"
                                                                 Background="#222D40"
                                                                 Foreground="{StaticResource AccentBlueBrush}"
                                                                 BorderThickness="0"/>
                                                    <TextBlock Text="{Binding FullPath}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 13: DOWNLOADS ASSISTANT & EMPTY FOLDER CLEANER                       -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsDownloadsSection, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kurulum Yaşı (Gün):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AvailableInstallerAgeDays}"
                                          SelectedItem="{Binding InstallerMinAgeDays}"
                                          Width="65"
                                          VerticalContentAlignment="Center"
                                          Margin="0,0,12,0"/>
