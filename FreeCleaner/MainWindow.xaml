                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9"
                                Margin="0,0,0,10">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Git Çalışma Alanı (Workspace) Klasörü:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding GitWorkspacePath, UpdateSourceTrigger=PropertyChanged}"
                                         Width="390"
                                         Padding="8,5"
                                         Background="#0D1422"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Klasör Seç &amp; Tara..."
                                        Padding="12,5"
                                        Command="{Binding BrowseGitWorkspaceCommand}"/>
                            </WrapPanel>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding GitRepoItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                <DataGridTextColumn Header="Proje / Depo Adı" Binding="{Binding RepoName}" IsReadOnly="True" Width="210"/>
                                <DataGridTextColumn Header="Aktif Branch" Binding="{Binding ActiveBranch}" IsReadOnly="True" Width="165"/>
                                <DataGridTextColumn Header="Çalışma Ağacı (git status)" Binding="{Binding WorkingTreeStatus}" IsReadOnly="True" Width="220"/>
                                <DataGridTextColumn Header=".git Boyutu" Binding="{Binding FormattedGitSize}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn Header="Tam Klasör Yolu" Binding="{Binding RepoRootPath}" IsReadOnly="True" Width="*"/>
                                <DataGridTemplateColumn Header="Klasör" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Aç"
                                                    Padding="10,3"
                                                    FontSize="11"
                                                    Command="{Binding DataContext.OpenGitRepoFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- MODULAR LAZY VIEWS HOST (Dashboard, LiveMonitor, DiskTreemap, Exif)      -->
                <!-- ========================================================================= -->
                <ContentControl x:Name="LazyModuleHost" Visibility="Collapsed"/>
            </Grid>

                    <!-- ==================== ROW 2: GLOBAL PROGRESS & LIVE LOG FOOTER ==================== -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,9"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Loc_LiveConsoleHeader}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Maximum="100"
                                             Height="5"
                                             Background="{DynamicResource BgCardBrush}"
                                             Foreground="{DynamicResource PrimaryGradientBrush}"
                                             BorderThickness="0"/>
                            </Grid>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ActivityLogs}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource AccentBlueBrush}"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="11.5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== CTRL+K QUICK COMMAND PALETTE OVERLAY ==================== -->
            <Grid x:Name="CommandPaletteOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="99"
                  Background="#99000000"
                  Visibility="Collapsed"
                  MouseDown="CommandPaletteBackdrop_MouseDown">
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Width="620"
                        MaxHeight="470"
                        VerticalAlignment="Top"
                        Margin="0,78,0,0"
                        Padding="14"
                        MouseDown="CommandPaletteCard_MouseDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource BgPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,7"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBlueBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource Loc_PalettePlaceholder}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CommandPaletteInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="CommandPaletteInput"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBlueBrush}"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         TextChanged="CommandPaletteInput_TextChanged"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="CommandPaletteList"
                                 Grid.Row="1"
                                 Background="{DynamicResource BgPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 MaxHeight="340"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="CommandPaletteList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,5" Width="560">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource AccentBlueBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,2"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource Loc_PaletteFooterHint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,2,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
