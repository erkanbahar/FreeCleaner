<Window x:Class="FreeCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FreeCleaner.ViewModels"
        mc:Ignorable="d"
        Title="FreeCleaner Pro (.NET 10) - Ultra Sistem Bakım &amp; Optimizasyon Paketi"
        Height="860"
        Width="1380"
        MinHeight="700"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border BorderBrush="#263654" BorderThickness="1" Background="{StaticResource BgPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom Modern Fluent Title / Command Bar -->
                <RowDefinition Height="52"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== TOP FLUENT COMMAND & TITLE BAR ==================== -->
            <Border Grid.Row="0"
                    Background="#0B111E"
                    BorderBrush="#1E2B45"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                    Padding="16,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Pill + Active Section Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource PrimaryGradientBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE945;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="FREECLEANER" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#17253E" BorderBrush="#2D4673" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="8,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO v4.0 • .NET 10" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Text="›" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SectionTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Quick Action Bar in Header -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Background="#112233" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="6" Padding="9,4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AdminStatusBadge, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="🛡️ Yönetici Başlat"
                                Padding="10,5"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Command="{Binding RestartAsAdminCommand}"
                                Visibility="{Binding IsNotAdmin, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="⚡ Oyun &amp; Performans Modu"
                                Padding="11,5"
                                FontSize="11.5"
                                Margin="0,0,6,0"
                                Command="{Binding ActivateGameBoosterCommand}"/>

                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="🧠 RAM Boşalt"
                                Padding="10,5"
                                FontSize="11.5"
                                Margin="0,0,6,0"
                                Command="{Binding OptimizeRamCommand}"/>

                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="📊 Rapor"
                                Padding="10,5"
                                FontSize="11.5"
                                Command="{Binding ExportReportsCommand}"/>
                    </StackPanel>

                    <!-- Custom Window Caption Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Simge Durumuna Küçült">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                Click="MaximizeRestoreButton_Click"
                                ToolTip="Ekranı Kapla / Geri Yükle">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Kapat">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN WORKSPACE GRID ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Navigation Sidebar -->
                    <ColumnDefinition Width="272"/>
                    <!-- Main Content Area -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT SIDEBAR ==================== -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBgGradientBrush}"
                        BorderBrush="#1E2B45"
                        BorderThickness="0,0,1,0"
                        Padding="14,12,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Navigation Menu (Scrollable) -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="TEMİZLEYİCİ MODÜLLERİ"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#475569"
                                           Margin="10,2,0,5"/>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsAllSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="All">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Akıllı Temizlik (Tümü)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsSystemSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="System">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Windows &amp; Sistem" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsBrowsersSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Browsers">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Web Tarayıcıları" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsAppsSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Apps">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Uygulama &amp; Geliştirici" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="ARAÇLAR &amp; OPTİMİZASYON"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,14,0,6"/>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsStartupSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Startup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Başlangıç Yöneticisi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsRegistrySection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Registry">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Kayıt Defteri (Registry)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsDiskAnalyzerSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="DiskAnalyzer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Büyük &amp; Kopya Dosyalar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsUninstallerSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Uninstaller">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Programlar &amp; Kalıntılar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsBoosterSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Booster">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="RAM &amp; Ağ Hızlandırıcı" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="PRO &amp; GÜVENLİK ARAÇLARI"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,14,0,6"/>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsDevCleanerSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="DevCleaner">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="VS Debug/Retail &amp; Dev" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsShredderSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Shredder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Dosya Öğütücü (DoD)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsPrivacySection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Privacy">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Gizlilik &amp; Telemetri" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsNetworkSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Network">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Canlı Ağ &amp; Hosts" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsTasksAndTreeSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="TasksAndTree">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Görevler &amp; Klasör Ağacı" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="SİSTEM BAKIM &amp; DONANIM"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,14,0,6"/>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsDownloadsSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Downloads">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="İndirilenler &amp; Boş Klasör" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsContextMenuSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="ContextMenu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Sağ Tık Menüsü (Shell)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsServicesSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Services">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE912;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Windows Servisleri" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsSmartPowerSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="SmartPower">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Disk Sağlığı &amp; Güç Planı" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsRepairCenterSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="RepairCenter">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Sistem Onarım (SFC/DISM)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="UZMAN &amp; KURUMSAL ARAÇLAR"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,14,0,6"/>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsUnlockerSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Unlocker">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Kilitli Dosya Çözücü" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsBrowserExtensionsSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="BrowserExtensions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA86;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Tarayıcı Eklentileri" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsDriversUpdatesSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="DriversUpdates">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Güncelleme &amp; Sürücüler" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsPathDoctorSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="PathDoctor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="PATH &amp; Kısayol Doktoru" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="5. NESİL ADLİ ANALİZ &amp; KURTARMA"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,14,0,6"/>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsCrashLogsSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="CrashLogs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Mavi Ekran &amp; Çökme Logları" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsWifiDnsSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="WifiDns">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Wi-Fi Şifre &amp; DNS Ping" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsPackageCachesSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="PackageCaches">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="NuGet / NPM &amp; WSL2 VHDX" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsRestoreGodModeSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="RestoreGodMode">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Geri Yükleme &amp; God Mode" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsFileAssocSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="FileAssoc">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Dosya Uzantısı Doktoru" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="6. NESİL DONANIM, PORT &amp; BLOATWARE"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,14,0,6"/>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsPortHunterSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="PortHunter">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Port Avcısı (Port Killer)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsBloatwareSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Bloatware">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Bloatware (Appx) Kaldırıcı" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsDiskBenchSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="DiskBench">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="SSD / NVMe Disk Hız Testi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsHardwareSpecsSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="HardwareSpecs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Donanım, BIOS &amp; Lisans" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsUsbForensicsSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="UsbForensics">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="USB Depolama Geçmişi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="GÜVENLİK, AĞ &amp; VERİMLİLİK"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="12,14,0,6"/>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsProcessSecuritySection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="ProcessSecurity">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Süreç &amp; İmza Denetçisi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsBatchRenamerSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="BatchRenamer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Toplu Dosya Adlandırıcı" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsNetworkAdapterDoctorSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="NetworkAdapterDoctor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Ağ Adaptörü &amp; IP Doktoru" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsFontManagerSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="FontManager">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Font (Yazı Tipi) Yöneticisi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsClipboardShieldSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="ClipboardShield">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Akıllı Pano (Clipboard) Kalkanı" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="{Binding IsSettingsSection, Mode=OneWay}"
                                     Command="{Binding SelectSectionCommand}"
                                     CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Beyaz Liste &amp; Raporlama" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Safety Option Box -->
                <Border Grid.Row="1"
                        Background="{StaticResource CardSurfaceGradientBrush}"
                        BorderBrush="#263859"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11,9"
                        Margin="0,10,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Güvenli Silme Kalkanı" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding UseRecycleBinSafety}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="11"
                                  Cursor="Hand"
                                  Content="Geri Dönüşüm Kutusuna taşı"/>
                    </StackPanel>
                </Border>

                <!-- System Telemetry Card at Bottom -->
                <Border Grid.Row="2"
                        Background="#0D1424"
                        BorderBrush="#223250"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{Binding SystemMetrics.OsName}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SystemMetrics.DotNetVersion}"
                                   FontSize="10"
                                   Foreground="{StaticResource AccentBlueBrush}"
                                   Margin="0,1,0,8"/>

                        <Grid>
                            <TextBlock Text="SİSTEM DİSKİ" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SystemMetrics.DriveUsedPercent, Mode=OneWay, StringFormat={}{0:F0}%}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding SystemMetrics.DriveUsedPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,4,0,3"
                                     Background="#1B263B"
                                     Foreground="{StaticResource PrimaryGradientBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding SystemMetrics.DriveSummaryText}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,7,0,0">
                            <TextBlock Text="BELLEK (RAM)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SystemMetrics.RamUsedPercent, Mode=OneWay, StringFormat={}{0:F0}%}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding SystemMetrics.RamUsedPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,4,0,3"
                                     Background="#1B263B"
                                     Foreground="{StaticResource CleanGradientBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding SystemMetrics.RamSummaryText}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1" Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Summary Cards -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Active Module Workspace -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Live Activity Log Footer -->
                <RowDefinition Height="108"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Top Dashboard Summary Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.45*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Detected Junk Size -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardSurfaceGradientBrush}"
                        BorderBrush="#283B5E"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,13">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TESPİT EDİLEN GEREKSİZ VERİ"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding TotalDetectedFormatted}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       Margin="0,4,0,3"/>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding TotalDetectedFiles, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                <Run Text="seçili dosya temizliğe hazır"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#172A4A" BorderBrush="#2563EB" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Freed Space in Session -->
                <Border Grid.Column="2"
                        Background="{StaticResource CardSurfaceGradientBrush}"
                        BorderBrush="#1F473E"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,13">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="BU OTURUMDA KAZANILAN ALAN"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding LastFreedFormatted}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentEmeraldBrush}"
                                       Margin="0,4,0,3"/>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding LastDeletedFiles, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                                <Run Text="öğe başarıyla temizlendi"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#112E28" BorderBrush="#10B981" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentEmeraldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3: Active Operation Status -->
                <Border Grid.Column="4"
                        Background="{StaticResource CardSurfaceGradientBrush}"
                        BorderBrush="#283B5E"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,13">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding SectionTitle}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>
                            <Button Style="{StaticResource DangerButtonStyle}"
                                    Content="⏹ İşlemi Durdur"
                                    Padding="10,3"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="36"
                                   Margin="0,5,0,3"/>
                        <TextBlock Text="{Binding CurrentOperationDetail}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== ROW 1: DYNAMIC MODULE VIEWS ==================== -->
            <Grid Grid.Row="1">

                <!-- ========================================================================= -->
                <!-- VIEW 1: CLEANER VIEW (All / System / Browsers / Apps)                     -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsCleanerViewVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cleaner Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Tümünü Seç"
                                        Command="{Binding SelectAllRulesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Seçimi Kaldır"
                                        Command="{Binding DeselectAllRulesCommand}"
                                        Margin="0,0,12,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Rapor Dışa Aktar (HTML/JSON)"
                                        Command="{Binding ExportReportCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AnalyzeCommand}"
                                        Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Analiz Et (Simülasyon)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Command="{Binding CleanCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Temizliği Başlat" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cleaner Split Area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rules List -->
                        <Border Grid.Column="0"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="TEMİZLİK KURALLARI &amp; HEDEFLER"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="4,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredRulesView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgCardBrush}"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,8"
                                                        Margin="0,0,4,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,9,0"
                                                                  Cursor="Hand"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconGlyph}"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource AccentBlueBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12.5"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding FormattedSize}"
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource AccentEmeraldBrush}"
                                                                       HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Discovered Files DataGrid -->
                        <Border Grid.Column="2"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="BULUNAN DOSYALAR (Çift tıklayarak klasörü açın)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource BgCardBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4">
                                        <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 CaretBrush="White"
                                                 BorderThickness="0"
                                                 FontSize="12"
                                                 ToolTip="Dosya adına göre filtrele"/>
                                    </Border>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding FilteredFilesView}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          Background="{StaticResource BgPrimaryBrush}"
                                          RowBackground="#141B26"
                                          AlternatingRowBackground="#18202D"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          BorderBrush="{StaticResource BorderSubtleBrush}"
                                          BorderThickness="1"
                                          RowHeight="29"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                        <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" IsReadOnly="True" Width="135"/>
                                        <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="90"/>
                                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" IsReadOnly="True" Width="110"/>
                                        <DataGridTextColumn Header="Dosya Yolu" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 2: STARTUP MANAGER                                                   -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsStartupSection, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Windows Açılışında Otomatik Başlayan Uygulamalar (HKCU / HKLM / Startup Klasörü)"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Listeyi Yenile"
                                    HorizontalAlignment="Right"
                                    Command="{Binding RefreshStartupCommand}"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding StartupItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{StaticResource BgPrimaryBrush}"
                                  RowBackground="#141B26"
                                  AlternatingRowBackground="#18202D"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="95"/>
                                <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="Açılış Etkisi" Binding="{Binding ImpactLevel}" Width="100"/>
                                <DataGridTextColumn Header="Konum" Binding="{Binding Location}" Width="190"/>
                                <DataGridTextColumn Header="Komut / Dosya Yolu" Binding="{Binding Command}" Width="*"/>
                                <DataGridTemplateColumn Header="İşlemler" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Etkin / Devre Dışı"
                                                        Padding="8,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Sil"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.DeleteStartupItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 3: REGISTRY CLEANER & BACKUP                                         -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsRegistrySection, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kayıt Defteri (Registry) Sorun Tarayıcı &amp; Otomatik .REG Yedekleyici"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Silinmiş programlardan kalan geçersiz App Paths, MuiCache, AppCompat ve kırık başlangıç kayıtlarını tespit eder."
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Sorunlar İçin Tara"
                                        Command="{Binding ScanRegistryCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Sadece .REG Yedeği Al"
                                        Command="{Binding BackupRegistryCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Yedekle ve Seçilileri Onar"
                                        Command="{Binding FixRegistryCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RegistryIssues}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{StaticResource BgPrimaryBrush}"
                                  RowBackground="#141B26"
                                  AlternatingRowBackground="#18202D"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Sorun Kategorisi" Binding="{Binding Category}" IsReadOnly="True" Width="220"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding ProblemDescription}" IsReadOnly="True" Width="250"/>
                                <DataGridTextColumn Header="Bulunamayan Dosya" Binding="{Binding MissingTarget}" IsReadOnly="True" Width="260"/>
                                <DataGridTextColumn Header="Kayıt Defteri Anahtarı" Binding="{Binding KeyPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 4: DISK ANALYZER (LARGE & DUPLICATE FILES)                           -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsDiskAnalyzerSection, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hedef Klasör:" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DiskScanTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Width="280"
                                         Background="{StaticResource BgCardBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         Padding="8,6"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Gözat..."
                                        Command="{Binding BrowseDiskFolderCommand}"
                                        Margin="0,0,14,0"/>

                                <TextBlock Text="Min Boyut (MB):" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AvailableSizeThresholdsMb}"
                                          SelectedItem="{Binding SelectedMinSizeMb}"
                                          Width="75"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Büyük Dosyaları Bul"
                                        Command="{Binding ScanLargeFilesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Çift (Kopya) Dosyaları Bul"
                                        Command="{Binding ScanDuplicatesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Seçilileri Geri Dönüşüm'e Taşı"
                                        Command="{Binding DeleteSelectedDiskFilesCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DiskAnalyzerItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{StaticResource BgPrimaryBrush}"
                                  RowBackground="#141B26"
                                  AlternatingRowBackground="#18202D"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="31"
                                  MouseDoubleClick="DiskDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Tür / Kopya Grubu" Binding="{Binding TypeBadge}" IsReadOnly="True" Width="135"/>
                                <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Dosya Adı" Binding="{Binding FileName}" IsReadOnly="True" Width="210"/>
                                <DataGridTextColumn Header="Değiştirilme" Binding="{Binding FormattedDate}" IsReadOnly="True" Width="125"/>
                                <DataGridTextColumn Header="Tam Yol (Çift tıklayarak Gezgin'de açın)" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 5: UNINSTALLER & ORPHAN APPDATA CLEANER                              -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsUninstallerSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Installed Apps List -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="YÜKLÜ PROGRAMLAR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Text="{Binding AppSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Width="180"
                                             Background="{StaticResource BgCardBrush}"
                                             Foreground="White"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Padding="6,4"
                                             ToolTip="Program ara..."/>
                                </StackPanel>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Yenile"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshInstalledAppsCommand}"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding FilteredInstalledAppsView}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{StaticResource BgPrimaryBrush}"
                                      RowBackground="#141B26"
                                      AlternatingRowBackground="#18202D"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="33">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="Yayımcı" Binding="{Binding Publisher}" Width="130"/>
                                    <DataGridTextColumn Header="Sürüm" Binding="{Binding DisplayVersion}" Width="80"/>
                                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="EstimatedSizeBytes" Width="85"/>
                                    <DataGridTemplateColumn Header="Kaldır" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Kaldır"
                                                        Padding="8,3"
                                                        Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Orphan AppData Folders -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="YETİM (ORPHAN) APPDATA KLASÖRLERİ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Kaldırılmış programlardan kalan eski klasörler" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Kalıntı Tara"
                                            Padding="12,7"
                                            Command="{Binding ScanOrphanFoldersCommand}"
                                            Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource CleanButtonStyle}"
                                            Content="Seçilileri Sil"
                                            Padding="12,7"
                                            Command="{Binding CleanOrphanFoldersCommand}"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding OrphanFolders}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{StaticResource BgPrimaryBrush}"
                                      RowBackground="#141B26"
                                      AlternatingRowBackground="#18202D"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="31">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                    <DataGridTextColumn Header="Klasör Adı" Binding="{Binding FolderName}" IsReadOnly="True" Width="135"/>
                                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="85"/>
                                    <DataGridTextColumn Header="Konum" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 6: RAM & NETWORK BOOSTER                                             -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsBoosterSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Booster Quick Action Cards -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="HIZLANDIRICI &amp; SİSTEM ARAÇLARI"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,12"/>

                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="RAM Bellek Boşaltıcı (Working Set Trim)" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="Arka planda çalışan uygulamaların kullanmadığı ayrılmış bellek sayfalarını işletim sistemine geri kazandırır."
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10"/>
                                    <Button Style="{StaticResource CleanButtonStyle}"
                                            Content="RAM Belleği Şimdi Optimize Et"
                                            Command="{Binding OptimizeRamCommand}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DNS &amp; Ağ Önbelleği Temizleyici" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="Bozuk DNS çözümleme önbelleğini (ipconfig /flushdns) ve hedef önbelleğini sıfırlayarak bağlantı sorunlarını giderir."
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="DNS Önbelleğini Sil"
                                                Command="{Binding FlushDnsCommand}"/>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Content="Ağ Önbelleğini Sıfırla"
                                                Command="{Binding ResetNetCacheCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Windows Derin Bakım Kısayolları" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,8"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Windows Disk Temizleme (cleanmgr / WinSxS)"
                                            Command="{Binding LaunchCleanMgrCommand}"
                                            Margin="0,0,0,8"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Sistem Geri Yükleme Noktası Yöneticisi"
                                            Command="{Binding LaunchSystemRestoreCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Top Memory Consuming Processes -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="EN ÇOK BELLEK (RAM) TÜKETEN İŞLEMLER"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Listeyi Yenile"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshTopProcessesCommand}"/>
                            </Grid>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding TopMemoryProcesses}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{StaticResource BgPrimaryBrush}"
                                      RowBackground="#141B26"
                                      AlternatingRowBackground="#18202D"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="90"/>
                                    <DataGridTextColumn Header="İşlem Adı (Process)" Binding="{Binding ProcessName}" Width="*"/>
                                    <DataGridTextColumn Header="Bellek Kullanımı (Working Set)" Binding="{Binding FormattedMemory}" SortMemberPath="WorkingSetBytes" Width="210"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 7: EXCLUSIONS (WHITELIST), AUTOMATION & REPORTING                    -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsSettingsSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- Whitelist / Exclusions Manager -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="BEYAZ LİSTE (KORUNAN KLASÖRLER &amp; İSTİSNALAR)"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Bu listedeki klasörler veya anahtar kelimeler hiçbir tarama ve temizleme işlemine dahil edilmez."
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewExclusionInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BgCardBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         Padding="8,6"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Ekle"
                                        Padding="14,6"
                                        Command="{Binding AddExclusionCommand}"
                                        Margin="0,0,6,0"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Content="Klasör Seç..."
                                        Command="{Binding BrowseExclusionFolderCommand}"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding ExcludedPaths}"
                                     Background="{StaticResource BgPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="12.5"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Content="Kaldır"
                                                    Padding="8,2"
                                                    Margin="12,0,0,0"
                                                    Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Automation & Reports Panel -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="OTOMASYON &amp; RAPORLAMA"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,12"/>

                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding AutoMonitorEnabled}"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Content="Arka Plan Akıllı Çöp İzleyiciyi Etkinleştir"/>
                                    <TextBlock Text="Belirlenen boyut eşiği aşıldığında otomatik olarak analiz uyarısı verir."
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Uyarı Eşiği (MB):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding AvailableSizeThresholdsMb}"
                                                  SelectedItem="{Binding AutoMonitorThresholdMb}"
                                                  Width="90"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Detaylı Temizlik &amp; Sistem Raporu" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="Sistem metriklerini, temizlik kurallarını ve işlem günlüklerini HTML ve JSON formatında Masaüstü klasörüne dışa aktarır."
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,12"/>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="HTML &amp; JSON Raporu Oluştur"
                                            Command="{Binding ExportReportCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 8: DEVCLEANER & GAMER DEEP CLEANER                                   -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsDevCleanerSection, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Visual Studio Debug & Retail Dedicated Auto-Clean Card -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource AccentBlueBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBlueBrush}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Visual Studio Projeleri: Debug &amp; Retail / Release Otomatik Temizleyici"
                                                   FontWeight="Bold"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Seçilen klasör altındaki tüm .sln, .slnx, .csproj ve .vcxproj projelerinin Debug, Retail, Release, x64 ve obj derleme çıktılarını otomatik bulur ve siler."
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding VsIncludeDebug}"
                                                  Content="Debug Klasörleri (bin\Debug, obj\Debug, x64\Debug)"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  FontSize="12"
                                                  Margin="0,0,16,0"/>
                                        <CheckBox IsChecked="{Binding VsIncludeRetailAndRelease}"
                                                  Content="Retail &amp; Release Klasörleri (Retail, Release)"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  FontSize="12"
                                                  Margin="0,0,16,0"/>
                                        <CheckBox IsChecked="{Binding VsIncludeObjAndVs}"
                                                  Content=".vs, ipch &amp; Ara Derleme (obj) Klasörleri"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="VS Debug/Retail Tara"
                                            Command="{Binding ScanVsDebugRetailCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource CleanButtonStyle}"
                                            Content="VS Debug &amp; Retail Otomatik Sil"
                                            Command="{Binding AutoCleanVsDebugRetailCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- General Dev Workspace & Gamer Toolbar -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Projeler Kök Dizini:" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DevWorkspacePath, UpdateSourceTrigger=PropertyChanged}"
                                         Width="260"
                                         Background="{StaticResource BgCardBrush}"
                                         Foreground="White"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         Padding="8,6"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Klasör Seç..."
                                        Command="{Binding BrowseDevWorkspaceCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Tüm Proje Çıktılarını Tara (node_modules, .venv)"
                                        Command="{Binding ScanDevProjectsCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Oyun &amp; Paket Önbellekleri (Steam, Shader, NuGet)"
                                        Command="{Binding ScanGamerCachesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Listeden Seçilileri Sil"
                                        Command="{Binding CleanDevArtifactsCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding DevArtifactItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{StaticResource BgPrimaryBrush}"
                                  RowBackground="#141B26"
                                  AlternatingRowBackground="#18202D"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Proje / Hedef Adı" Binding="{Binding ProjectName}" IsReadOnly="True" Width="210"/>
                                <DataGridTextColumn Header="Klasör Türü" Binding="{Binding ArtifactType}" IsReadOnly="True" Width="150"/>
                                <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Son Değişiklik" Binding="{Binding FormattedDate}" IsReadOnly="True" Width="125"/>
                                <DataGridTextColumn Header="Tam Klasör Yolu" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 9: FILE SHREDDER (DoD 5220.22-M) & FREE SPACE WIPER                  -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsShredderSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Shredder Queue -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="+ Dosya Ekle"
                                            Command="{Binding AddShredFilesCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
