                <!-- VIEW 32: PROCESS SECURITY & UNSIGNED BINARY HUNTER                        -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsProcessSecuritySection, Converter={StaticResource BoolToVis}}"
