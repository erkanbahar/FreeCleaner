                                    <DataGridTextColumn Header="IP Adresi" Binding="{Binding IpAddress}" Width="105"/>
                                    <DataGridTextColumn Header="Alan Adı (Host)" Binding="{Binding Hostname}" Width="165"/>
                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Comment}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 12: SCHEDULED TASKS & FOLDER SPACE VISUALIZER                        -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsTasksAndTreeSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Scheduled Tasks -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="ZAMANLANMIŞ GÖREVLER (WINDOWS TASK SCHEDULER)"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
