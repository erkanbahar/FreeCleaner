                                              SelectedItem="{Binding ShredPassesCount}"
                                              Width="65"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Background="{StaticResource DangerRedBrush}"
                                        Content="Kalıcı Olarak Öğüt &amp; İmha Et"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ExecuteShredderCommand}"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ShredQueueItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{StaticResource BgPrimaryBrush}"
                                      RowBackground="#141B26"
                                      AlternatingRowBackground="#18202D"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Dosya / Klasör Adı" Binding="{Binding Name}" Width="210"/>
                                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" Width="100"/>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="150"/>
                                    <DataGridTextColumn Header="Tam Yol" Binding="{Binding FullPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Free Space Wiper Card -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="SÜRÜCÜ BOŞ ALAN SİLİCİ (FREE SPACE WIPER)"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,12"/>

                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Kriptografik Boş Sektör Sıfırlama" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="Daha önce normal yollarla silinmiş dosyaların diskteki boş sektörlerde bıraktığı izleri kriptografik rastgele veri yazarak kurtarılamaz hale getirir (Mevcut dosyalarınıza dokunmaz)."
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Sıfırlama Boyutu (MB):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding AvailableSizeThresholdsMb}"
                                                  SelectedItem="{Binding FreeSpaceWipeMb}"
                                                  Width="90"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Boş Alanı Şimdi Sıfırla"
                                            Command="{Binding WipeFreeSpaceCommand}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1D1622" BorderBrush="#4C1D24" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="DoD 5220.22-M Standardı Nedir?" FontWeight="SemiBold" Foreground="#F87171" FontSize="12.5"/>
                                    <TextBlock Text="1. Geçiş: Tüm sektörlere 0x00 yazılır.&#x0a;2. Geçiş: Tüm sektörlere 0xFF yazılır.&#x0a;3. Geçiş: Kriptografik rastgele baytlar yazılır, dosya boyutu 0'a indirilir ve MFT dosya adı rastgele değiştirilerek silinir."
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 10: WINDOWS PRIVACY & TELEMETRY SHIELD                               -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsPrivacySection, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Windows Gizlilik, Etkinlik Geçmişi &amp; Kabuk İzleri Kalkanı"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Çalıştır (Win+R) geçmişi, Dosya Gezgini arama/adres geçmişi, Görev Çubuğu JumpList, Timeline ve Pano verilerini temizler."
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Gizlilik İzlerini Tara"
                                        Command="{Binding ScanPrivacyTracesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Seçili İzleri Temizle"
                                        Command="{Binding CleanPrivacyTracesCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PrivacyTraces}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{StaticResource BgPrimaryBrush}"
                                  RowBackground="#141B26"
                                  AlternatingRowBackground="#18202D"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" IsReadOnly="True" Width="150"/>
