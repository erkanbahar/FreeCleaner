                                                    FontSize="11"
                                                    Command="{Binding DataContext.ApplySanitizedClipboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

                    <!-- ==================== ROW 2: GLOBAL PROGRESS & LIVE LOG FOOTER ==================== -->
                    <Border Grid.Row="2"
                            Background="#0C1322"
                            BorderBrush="#223250"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,9"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="CANLI TELEMETRİ &amp; İŞLEM KONSOLU"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Maximum="100"
                                             Height="5"
                                             Background="#1A253A"
                                             Foreground="{StaticResource PrimaryGradientBrush}"
                                             BorderThickness="0"/>
                            </Grid>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ActivityLogs}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#93C5FD"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="11.5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
