                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== ROW 1: DYNAMIC MODULE VIEWS ==================== -->
            <Grid Grid.Row="1">

                <!-- ========================================================================= -->
                <!-- VIEW 1: CLEANER VIEW (All / System / Browsers / Apps)                     -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsCleanerViewVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cleaner Toolbar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Tümünü Seç"
                                        Command="{Binding SelectAllRulesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Seçimi Kaldır"
                                        Command="{Binding DeselectAllRulesCommand}"
                                        Margin="0,0,12,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Rapor Dışa Aktar (HTML/JSON)"
                                        Command="{Binding ExportReportCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AnalyzeCommand}"
                                        Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Analiz Et (Simülasyon)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Command="{Binding CleanCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Temizliği Başlat" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cleaner Split Area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rules List -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="TEMİZLİK KURALLARI &amp; HEDEFLER"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="4,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredRulesView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgCardBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="10,8"
                                                        Margin="0,0,4,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,9,0"
                                                                  Cursor="Hand"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconGlyph}"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource AccentBlueBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12.5"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding RiskLabel}"
                                                                       FontSize="9.5"
                                                                       Foreground="{DynamicResource WarningAmberBrush}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding FormattedSize}"
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource AccentEmeraldBrush}"
                                                                       HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Discovered Files DataGrid -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="BULUNAN DOSYALAR (Çift tıklayarak klasörü açın)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableRiskFilters}"
                                              SelectedItem="{Binding RiskFilter, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,8,0"
                                              Padding="6,3"
                                              FontSize="11"
                                              ToolTip="Risk seviyesine göre filtrele"/>
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource BgCardBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4">
                                        <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="White"
                                                 BorderThickness="0"
                                                 FontSize="12"
                                                 ToolTip="Dosya adına göre filtrele"/>
                                    </Border>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding FilteredFilesView}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          Background="{DynamicResource BgPrimaryBrush}"
                                          RowBackground="{DynamicResource BgSecondaryBrush}"
                                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                                          BorderThickness="1"
                                          RowHeight="29"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                        <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" IsReadOnly="True" Width="135"/>
                                        <DataGridTextColumn Header="Risk" Binding="{Binding RiskLabel}" IsReadOnly="True" Width="70"/>
                                        <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="90"/>
                                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" IsReadOnly="True" Width="110"/>
                                        <DataGridTextColumn Header="Dosya Yolu" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 2: STARTUP MANAGER                                                   -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsStartupSection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Windows Açılışında Otomatik Başlayan Uygulamalar (HKCU / HKLM / Startup Klasörü)"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Listeyi Yenile"
                                    HorizontalAlignment="Right"
                                    Command="{Binding RefreshStartupCommand}"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding StartupItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="95"/>
                                <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="Açılış Etkisi" Binding="{Binding ImpactLevel}" Width="100"/>
                                <DataGridTextColumn Header="Konum" Binding="{Binding Location}" Width="190"/>
                                <DataGridTextColumn Header="Komut / Dosya Yolu" Binding="{Binding Command}" Width="*"/>
                                <DataGridTemplateColumn Header="İşlemler" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Etkin / Devre Dışı"
                                                        Padding="8,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Sil"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.DeleteStartupItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 3: REGISTRY CLEANER & BACKUP                                         -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsRegistrySection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="260"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kayıt Defteri (Registry) Sorun Tarayıcı &amp; Otomatik .REG Yedekleyici"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Silinmiş programlardan kalan geçersiz App Paths, MuiCache, AppCompat ve kırık başlangıç kayıtlarını tespit eder."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Sorunlar İçin Tara"
                                        Command="{Binding ScanRegistryCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Sadece .REG Yedeği Al"
                                        Command="{Binding BackupRegistryCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Son Yedeği Geri Yükle"
                                        Command="{Binding RestoreRegistryBackupCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Yedekle ve Seçilileri Onar"
                                        Command="{Binding FixRegistryCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RegistryIssues}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Sorun Kategorisi" Binding="{Binding Category}" IsReadOnly="True" Width="220"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding ProblemDescription}" IsReadOnly="True" Width="250"/>
                                <DataGridTextColumn Header="Bulunamayan Dosya" Binding="{Binding MissingTarget}" IsReadOnly="True" Width="260"/>
                                <DataGridTextColumn Header="Kayıt Defteri Anahtarı" Binding="{Binding KeyPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Margin="0,12,0,0"
                                Padding="10"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="YEDEK YÖNETİCİSİ"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="Yenile"
                                                Command="{Binding RefreshBackupsCommand}"
                                                Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource CleanButtonStyle}"
                                                Content="Seçili Yedeği Geri Yükle"
                                                Command="{Binding RestoreSelectedBackupCommand}"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding BackupFiles}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          Background="{DynamicResource BgPrimaryBrush}"
                                          RowBackground="{DynamicResource BgSecondaryBrush}"
                                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                                          BorderThickness="1"
                                          RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                        <DataGridTextColumn Header="Tür" Binding="{Binding BackupType}" IsReadOnly="True" Width="90"/>
                                        <DataGridTextColumn Header="Dosya" Binding="{Binding FileName}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Tarih" Binding="{Binding FormattedDate}" IsReadOnly="True" Width="145"/>
                                        <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" IsReadOnly="True" Width="85"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 4: DISK ANALYZER (LARGE & DUPLICATE FILES)                           -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsDiskAnalyzerSection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hedef Klasör:" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DiskScanTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Width="280"
                                         Background="{DynamicResource BgCardBrush}"
                                         Foreground="White"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         Padding="8,6"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Gözat..."
                                        Command="{Binding BrowseDiskFolderCommand}"
                                        Margin="0,0,14,0"/>

                                <TextBlock Text="Min Boyut (MB):" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AvailableSizeThresholdsMb}"
                                          SelectedItem="{Binding SelectedMinSizeMb}"
                                          Width="75"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Büyük Dosyaları Bul"
                                        Command="{Binding ScanLargeFilesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Çift (Kopya) Dosyaları Bul"
                                        Command="{Binding ScanDuplicatesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Seçilileri Geri Dönüşüm'e Taşı"
                                        Command="{Binding DeleteSelectedDiskFilesCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DiskAnalyzerItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="31"
                                  MouseDoubleClick="DiskDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Tür / Kopya Grubu" Binding="{Binding TypeBadge}" IsReadOnly="True" Width="135"/>
                                <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Dosya Adı" Binding="{Binding FileName}" IsReadOnly="True" Width="210"/>
                                <DataGridTextColumn Header="Değiştirilme" Binding="{Binding FormattedDate}" IsReadOnly="True" Width="125"/>
                                <DataGridTextColumn Header="Tam Yol (Çift tıklayarak Gezgin'de açın)" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 5: UNINSTALLER & ORPHAN APPDATA CLEANER                              -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsUninstallerSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Installed Apps List -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="YÜKLÜ PROGRAMLAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Text="{Binding AppSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Width="180"
                                             Background="{DynamicResource BgCardBrush}"
                                             Foreground="White"
                                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                                             Padding="6,4"
                                             ToolTip="Program ara..."/>
                                </StackPanel>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Yenile"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshInstalledAppsCommand}"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding FilteredInstalledAppsView}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{DynamicResource BgPrimaryBrush}"
                                      RowBackground="{DynamicResource BgSecondaryBrush}"
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="33">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="Yayımcı" Binding="{Binding Publisher}" Width="130"/>
                                    <DataGridTextColumn Header="Sürüm" Binding="{Binding DisplayVersion}" Width="80"/>
                                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="EstimatedSizeBytes" Width="85"/>
                                    <DataGridTemplateColumn Header="Kaldır" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Kaldır"
                                                        Padding="8,3"
                                                        Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Orphan AppData Folders -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="YETİM (ORPHAN) APPDATA KLASÖRLERİ" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Kaldırılmış programlardan kalan eski klasörler" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Kalıntı Tara"
                                            Padding="12,7"
                                            Command="{Binding ScanOrphanFoldersCommand}"
                                            Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource CleanButtonStyle}"
                                            Content="Seçilileri Sil"
                                            Padding="12,7"
                                            Command="{Binding CleanOrphanFoldersCommand}"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding OrphanFolders}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{DynamicResource BgPrimaryBrush}"
                                      RowBackground="{DynamicResource BgSecondaryBrush}"
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="31">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                    <DataGridTextColumn Header="Klasör Adı" Binding="{Binding FolderName}" IsReadOnly="True" Width="135"/>
                                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="85"/>
                                    <DataGridTextColumn Header="Konum" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 6: RAM & NETWORK BOOSTER                                             -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsBoosterSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Booster Quick Action Cards -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="HIZLANDIRICI &amp; SİSTEM ARAÇLARI"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="RAM Bellek Boşaltıcı (Working Set Trim)" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="Arka planda çalışan uygulamaların kullanmadığı ayrılmış bellek sayfalarını işletim sistemine geri kazandırır."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10"/>
                                    <Button Style="{StaticResource CleanButtonStyle}"
                                            Content="RAM Belleği Şimdi Optimize Et"
                                            Command="{Binding OptimizeRamCommand}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DNS &amp; Ağ Önbelleği Temizleyici" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="Bozuk DNS çözümleme önbelleğini (ipconfig /flushdns) ve hedef önbelleğini sıfırlayarak bağlantı sorunlarını giderir."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="DNS Önbelleğini Sil"
                                                Command="{Binding FlushDnsCommand}"/>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Content="Ağ Önbelleğini Sıfırla"
                                                Command="{Binding ResetNetCacheCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Windows Derin Bakım Kısayolları" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,8"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Windows Disk Temizleme (cleanmgr / WinSxS)"
                                            Command="{Binding LaunchCleanMgrCommand}"
                                            Margin="0,0,0,8"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Sistem Geri Yükleme Noktası Yöneticisi"
                                            Command="{Binding LaunchSystemRestoreCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Top Memory Consuming Processes -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="EN ÇOK BELLEK (RAM) TÜKETEN İŞLEMLER"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Listeyi Yenile"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshTopProcessesCommand}"/>
                            </Grid>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding TopMemoryProcesses}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{DynamicResource BgPrimaryBrush}"
                                      RowBackground="{DynamicResource BgSecondaryBrush}"
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="90"/>
                                    <DataGridTextColumn Header="İşlem Adı (Process)" Binding="{Binding ProcessName}" Width="*"/>
                                    <DataGridTextColumn Header="Bellek Kullanımı (Working Set)" Binding="{Binding FormattedMemory}" SortMemberPath="WorkingSetBytes" Width="210"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 7: EXCLUSIONS (WHITELIST), AUTOMATION & REPORTING                    -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsSettingsSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- Whitelist / Exclusions Manager -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Loc_SettingsWhitelistTitle}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_SettingsWhitelistDesc}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewExclusionInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource BgCardBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBlueBrush}"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         Padding="8,6"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsAddBtn}"
                                        Padding="14,6"
                                        Command="{Binding AddExclusionCommand}"
                                        Margin="0,0,6,0"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsBrowseBtn}"
                                        Command="{Binding BrowseExclusionFolderCommand}"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding ExcludedPaths}"
                                     Background="{DynamicResource BgPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="12.5"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Content="{DynamicResource Loc_SettingsRemoveBtn}"
                                                    Padding="8,2"
                                                    Margin="12,0,0,0"
                                                    Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Automation & Reports Panel -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_SettingsRightHeader}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,12"/>

                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_SettingsThemeLangTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Loc_SettingsThemeLangDesc}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource Loc_SettingsThemeLabel}" Width="95" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                                      SelectedItem="{Binding SelectedTheme}"
                                                      Width="210"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Loc_SettingsLangLabel}" Width="95" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Code"
                                                      SelectedValue="{Binding SelectedLanguage}"
                                                      Width="210"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- App Version & GitHub Releases Update Checker -->
                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Loc_SettingsUpdateTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding AppVersionDisplay}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Loc_SettingsUpdateDesc}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,8"/>
                                        <TextBlock Text="{Binding UpdateStatusText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentEmeraldBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="{DynamicResource Loc_SettingsCheckUpdateBtn}"
                                                    Command="{Binding CheckForUpdatesCommand}"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource SubtleButtonStyle}"
                                                    Content="{DynamicResource Loc_SettingsOpenReleasesBtn}"
                                                    Command="{Binding OpenLatestReleasePageCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding AutoMonitorEnabled}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontWeight="SemiBold"
                                                  FontSize="13"
                                                  Content="{DynamicResource Loc_SettingsAutoMonCheck}"/>
                                        <TextBlock Text="{DynamicResource Loc_SettingsAutoMonDesc}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Loc_SettingsThresholdLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox ItemsSource="{Binding AvailableSizeThresholdsMb}"
                                                      SelectedItem="{Binding AutoMonitorThresholdMb}"
                                                      Width="90"/>
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding MinimizeToTrayOnClose}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontWeight="SemiBold"
                                                  FontSize="12.5"
                                                  Content="{DynamicResource Loc_SettingsTrayCheck}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding ScheduledMaintenanceEnabled}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontWeight="SemiBold"
                                                  FontSize="13"
                                                  Content="{DynamicResource Loc_SettingsSchedCheck}"/>
                                        <TextBlock Text="{DynamicResource Loc_SettingsSchedDesc}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                           <TextBlock Text="{DynamicResource Loc_SettingsIntervalLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                           <ComboBox ItemsSource="{Binding AvailableMaintenanceIntervalsHours}"
                                                     SelectedItem="{Binding ScheduledMaintenanceIntervalHours}"
                                                     Width="90"/>
                                           <TextBlock Text="{DynamicResource Loc_SettingsHoursSuffix}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="{DynamicResource Loc_SettingsInstallTaskBtn}"
                                                    Command="{Binding InstallScheduledMaintenanceCommand}"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource SubtleButtonStyle}"
                                                    Content="{DynamicResource Loc_SettingsRemoveTaskBtn}"
                                                    Command="{Binding RemoveScheduledMaintenanceCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_SettingsReportTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Loc_SettingsReportDesc}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,12"/>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="{DynamicResource Loc_SettingsExportReportBtn}"
                                                Command="{Binding ExportReportCommand}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 8: DEVCLEANER & GAMER DEEP CLEANER                                   -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsDevCleanerSection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Visual Studio Debug & Retail Dedicated Auto-Clean Card -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource AccentBlueBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBlueBrush}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Visual Studio Projeleri: Debug &amp; Retail / Release Otomatik Temizleyici"
                                                   FontWeight="Bold"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Seçilen klasör altındaki tüm .sln, .slnx, .csproj ve .vcxproj projelerinin Debug, Retail, Release, x64 ve obj derleme çıktılarını otomatik bulur ve siler."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding VsIncludeDebug}"
                                                  Content="Debug Klasörleri (bin\Debug, obj\Debug, x64\Debug)"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="12"
                                                  Margin="0,0,16,0"/>
                                        <CheckBox IsChecked="{Binding VsIncludeRetailAndRelease}"
                                                  Content="Retail &amp; Release Klasörleri (Retail, Release)"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="12"
                                                  Margin="0,0,16,0"/>
                                        <CheckBox IsChecked="{Binding VsIncludeObjAndVs}"
                                                  Content=".vs, ipch &amp; Ara Derleme (obj) Klasörleri"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="VS Debug/Retail Tara"
                                            Command="{Binding ScanVsDebugRetailCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource CleanButtonStyle}"
                                            Content="VS Debug &amp; Retail Otomatik Sil"
                                            Command="{Binding AutoCleanVsDebugRetailCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- General Dev Workspace & Gamer Toolbar -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Projeler Kök Dizini:" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DevWorkspacePath, UpdateSourceTrigger=PropertyChanged}"
                                         Width="260"
                                         Background="{DynamicResource BgCardBrush}"
                                         Foreground="White"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         Padding="8,6"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Klasör Seç..."
                                        Command="{Binding BrowseDevWorkspaceCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Tüm Proje Çıktılarını Tara (node_modules, .venv)"
                                        Command="{Binding ScanDevProjectsCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Oyun &amp; Paket Önbellekleri (Steam, Shader, NuGet)"
                                        Command="{Binding ScanGamerCachesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Listeden Seçilileri Sil"
                                        Command="{Binding CleanDevArtifactsCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding DevArtifactItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Proje / Hedef Adı" Binding="{Binding ProjectName}" IsReadOnly="True" Width="210"/>
                                <DataGridTextColumn Header="Klasör Türü" Binding="{Binding ArtifactType}" IsReadOnly="True" Width="150"/>
                                <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Son Değişiklik" Binding="{Binding FormattedDate}" IsReadOnly="True" Width="125"/>
                                <DataGridTextColumn Header="Tam Klasör Yolu" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 9: FILE SHREDDER (DoD 5220.22-M) & FREE SPACE WIPER                  -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsShredderSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Shredder Queue -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="+ Dosya Ekle"
                                            Command="{Binding AddShredFilesCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="+ Klasör Ekle"
                                            Command="{Binding AddShredFolderCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Listeyi Temizle"
                                            Command="{Binding ClearShredQueueCommand}"
                                            Margin="0,0,14,0"/>
                                    <TextBlock Text="Geçiş Sayısı (DoD):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableShredPasses}"
                                              SelectedItem="{Binding ShredPassesCount}"
                                              Width="65"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Background="{DynamicResource DangerRedBrush}"
                                        Content="Kalıcı Olarak Öğüt &amp; İmha Et"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ExecuteShredderCommand}"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ShredQueueItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{DynamicResource BgPrimaryBrush}"
                                      RowBackground="{DynamicResource BgSecondaryBrush}"
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Dosya / Klasör Adı" Binding="{Binding Name}" Width="210"/>
                                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" Width="100"/>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="150"/>
                                    <DataGridTextColumn Header="Tam Yol" Binding="{Binding FullPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Free Space Wiper Card -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="SÜRÜCÜ BOŞ ALAN SİLİCİ (FREE SPACE WIPER)"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Kriptografik Boş Sektör Sıfırlama" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="Daha önce normal yollarla silinmiş dosyaların diskteki boş sektörlerde bıraktığı izleri kriptografik rastgele veri yazarak kurtarılamaz hale getirir (Mevcut dosyalarınıza dokunmaz)."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Sıfırlama Boyutu (MB):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding AvailableSizeThresholdsMb}"
                                                  SelectedItem="{Binding FreeSpaceWipeMb}"
                                                  Width="90"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Boş Alanı Şimdi Sıfırla"
                                            Command="{Binding WipeFreeSpaceCommand}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1D1622" BorderBrush="#4C1D24" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="DoD 5220.22-M Standardı Nedir?" FontWeight="SemiBold" Foreground="#F87171" FontSize="12.5"/>
                                    <TextBlock Text="1. Geçiş: Tüm sektörlere 0x00 yazılır.&#x0a;2. Geçiş: Tüm sektörlere 0xFF yazılır.&#x0a;3. Geçiş: Kriptografik rastgele baytlar yazılır, dosya boyutu 0'a indirilir ve MFT dosya adı rastgele değiştirilerek silinir."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 10: WINDOWS PRIVACY & TELEMETRY SHIELD                               -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsPrivacySection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Windows Gizlilik, Etkinlik Geçmişi &amp; Kabuk İzleri Kalkanı"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Çalıştır (Win+R) geçmişi, Dosya Gezgini arama/adres geçmişi, Görev Çubuğu JumpList, Timeline ve Pano verilerini temizler."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Gizlilik İzlerini Tara"
                                        Command="{Binding ScanPrivacyTracesCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Seçili İzleri Temizle"
                                        Command="{Binding CleanPrivacyTracesCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PrivacyTraces}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" IsReadOnly="True" Width="150"/>
                                <DataGridTextColumn Header="Gizlilik Öğesi" Binding="{Binding Name}" IsReadOnly="True" Width="280"/>
                                <DataGridTextColumn Header="Bulunan İz / Boyut" Binding="{Binding StatusText}" IsReadOnly="True" Width="130"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 11: ACTIVE NETWORK CONNECTIONS & HOSTS EDITOR                        -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsNetworkSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active TCP/UDP Connections -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="CANLI TCP / UDP AĞ BAĞLANTILARI &amp; PORT DENETÇİSİ"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Bağlantıları Yenile"
                                        Padding="12,6"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshConnectionsCommand}"/>
                            </Grid>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ActiveConnections}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{DynamicResource BgPrimaryBrush}"
                                      RowBackground="{DynamicResource BgSecondaryBrush}"
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="30">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Protokol" Binding="{Binding Protocol}" Width="65"/>
                                    <DataGridTextColumn Header="İşlem (Process)" Binding="{Binding ProcessName}" Width="140"/>
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                                    <DataGridTextColumn Header="Yerel Adres" Binding="{Binding LocalAddress}" Width="145"/>
                                    <DataGridTextColumn Header="Uzak Adres" Binding="{Binding RemoteAddress}" Width="145"/>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Windows Hosts File Manager -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="WINDOWS HOSTS DOSYASI YÖNETİCİSİ"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Yenile"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshHostsCommand}"
                                        Margin="0,0,84,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Yedeği Geri Yükle"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RestoreHostsBackupCommand}"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewHostIp, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource BgCardBrush}"
                                         Foreground="White"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         Padding="6,5"
                                         Margin="0,0,6,0"
                                         ToolTip="Hedef IP (Engellemek için 0.0.0.0)"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewHostDomain, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource BgCardBrush}"
                                         Foreground="White"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         Padding="6,5"
                                         Margin="0,0,6,0"
                                         ToolTip="Alan adı (örn: telemetry.example.com)"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Kural Ekle"
                                        Padding="12,5"
                                        Command="{Binding AddHostEntryCommand}"/>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding HostsEntries}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{DynamicResource BgPrimaryBrush}"
                                      RowBackground="{DynamicResource BgSecondaryBrush}"
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="30">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Etkin" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                                    <DataGridTextColumn Header="IP Adresi" Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                                    <DataGridTextColumn Header="Alan Adı (Host)" Binding="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" Width="165"/>
                                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTemplateColumn Header="İşlemler" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                                            Content="Kaydet"
                                                            Padding="6,3"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.SaveHostEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                                            Content="Sil"
                                                            Padding="6,3"
                                                            Command="{Binding DataContext.DeleteHostEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 12: SCHEDULED TASKS & FOLDER SPACE VISUALIZER                        -->
                <!-- ========================================================================= -->
                <Grid Visibility="{Binding IsTasksAndTreeSection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Scheduled Tasks -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="ZAMANLANMIŞ GÖREVLER (WINDOWS TASK SCHEDULER)"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Görevleri Yenile"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshScheduledTasksCommand}"/>
                            </Grid>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ScheduledTasks}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{DynamicResource BgPrimaryBrush}"
                                      RowBackground="{DynamicResource BgSecondaryBrush}"
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      RowHeight="31">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Görev Adı" Binding="{Binding TaskName}" Width="180"/>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="85"/>
                                    <DataGridTextColumn Header="Sonraki Çalışma" Binding="{Binding NextRunTime}" Width="135"/>
                                    <DataGridTextColumn Header="Görev Yolu" Binding="{Binding TaskPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Folder Space Visualizer -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DİSK KLASÖR AĞACI:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SpaceTreeTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Width="195"
                                             Background="{DynamicResource BgCardBrush}"
                                             Foreground="White"
                                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                                             Padding="6,4"
                                             Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Seç..."
                                            Command="{Binding BrowseSpaceTreeFolderCommand}"/>
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Analiz Et"
                                        Padding="12,5"
                                        HorizontalAlignment="Right"
                                        Command="{Binding AnalyzeFolderSpaceTreeCommand}"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FolderSpaceItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCardBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    Margin="0,0,4,7">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" FontSize="12.5"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource AccentEmeraldBrush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding PercentageOfParent, Mode=OneWay}"
                                                                 Maximum="100"
                                                                 Height="6"
                                                                 Margin="0,6,0,2"
                                                                 Background="#222D40"
                                                                 Foreground="{DynamicResource AccentBlueBrush}"
                                                                 BorderThickness="0"/>
                                                    <TextBlock Text="{Binding FullPath}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW 13: DOWNLOADS ASSISTANT & EMPTY FOLDER CLEANER                       -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsDownloadsSection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kurulum Yaşı (Gün):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AvailableInstallerAgeDays}"
                                          SelectedItem="{Binding InstallerMinAgeDays}"
                                          Width="65"
                                          VerticalContentAlignment="Center"
                                          Margin="0,0,12,0"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="İndirilenler (.exe, .msi, .iso, .zip) Tara"
                                        Command="{Binding ScanOldInstallersCommand}"
                                        Margin="0,0,14,0"/>

                                <TextBlock Text="Boş Klasör Hedefi:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding EmptyFolderScanTarget, UpdateSourceTrigger=PropertyChanged}"
                                         Width="185"
                                         Background="{DynamicResource BgCardBrush}"
                                         Foreground="White"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                         Padding="6,5"
                                         Margin="0,0,6,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Seç..."
                                        Command="{Binding BrowseEmptyFolderTargetCommand}"
                                        Margin="0,0,6,0"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Boş Klasörleri Bul"
                                        Command="{Binding ScanEmptyFoldersCommand}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource CleanButtonStyle}"
                                    Content="Seçilileri Temizle"
                                    Command="{Binding CleanDownloadsAndEmptyCommand}"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DownloadsAndEmptyItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Tür" Binding="{Binding ItemType}" IsReadOnly="True" Width="175"/>
                                <DataGridTextColumn Header="Adı" Binding="{Binding Name}" IsReadOnly="True" Width="220"/>
                                <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Tarih / Yaş" Binding="{Binding FormattedAge}" IsReadOnly="True" Width="155"/>
                                <DataGridTextColumn Header="Tam Yol" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 14: SHELL CONTEXT MENU MANAGER                                       -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsContextMenuSection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Windows Sağ Tık Bağlam Menüsü (Context Menu) Yöneticisi"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Dosya, klasör ve masaüstü sağ tık menüsünü yavaşlatan 3. parti kabuk eklentilerini (HKCR\*\shellex) listeler ve temizler."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Menü Öğelerini Yenile"
                                        Command="{Binding RefreshContextMenuCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource CleanButtonStyle}"
                                        Content="Seçili Sağ Tık Öğelerini Kaldır"
                                        Command="{Binding DeleteContextMenuCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ContextMenuEntries}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="Kapsam (Scope)" Binding="{Binding TargetScope}" IsReadOnly="True" Width="190"/>
                                <DataGridTextColumn Header="Menü Eklenti Adı" Binding="{Binding Name}" IsReadOnly="True" Width="210"/>
                                <DataGridTextColumn Header="CLSID / Komut" Binding="{Binding HandlerValue}" IsReadOnly="True" Width="260"/>
                                <DataGridTextColumn Header="Kayıt Defteri Yolu" Binding="{Binding RegistrySubKeyPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 15: WINDOWS SERVICES & TELEMETRY OPTIMIZER                           -->
                <!-- ========================================================================= -->
                <Border Visibility="{Binding IsServicesSection, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Windows Arka Plan Servisleri &amp; Telemetri Optimizasyon Yöneticisi"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Telemetri (DiagTrack), SysMain (Superfetch), Windows Search, Yazdırma Biriktiricisi ve Xbox servislerini yönetin."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Servis Durumlarını Yenile"
                                    HorizontalAlignment="Right"
                                    Command="{Binding RefreshServicesCommand}"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding OptimizableServices}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="{DynamicResource BgPrimaryBrush}"
                                  RowBackground="{DynamicResource BgSecondaryBrush}"
                                  AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Servis Kodu" Binding="{Binding ServiceName}" Width="130"/>
                                <DataGridTextColumn Header="Servis Adı" Binding="{Binding DisplayName}" Width="230"/>
                                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="140"/>
                                <DataGridTextColumn Header="Başlangıç" Binding="{Binding StartType}" Width="95"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                                <DataGridTemplateColumn Header="Kontrol" Width="165">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Durdur"
                                                        Padding="8,3"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Başlat"
                                                        Padding="8,3"
                                                        Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

