                <!-- Row 0: Top Summary Cards -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Active Module Workspace -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Live Activity Log Footer -->
                <RowDefinition Height="108"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Top Dashboard Summary Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.45*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Detected Junk Size -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardSurfaceGradientBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,13">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SummaryDetectedHeader}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalDetectedFormatted}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       Margin="0,4,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalDetectedFiles, Mode=OneWay, StringFormat={}{0:N0}}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc_SummaryDetectedSuffix}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Freed Space in Session -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardSurfaceGradientBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,13">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SummaryFreedHeader}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LastFreedFormatted}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentEmeraldBrush}"
                                       Margin="0,4,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LastDeletedFiles, Mode=OneWay, StringFormat={}{0:N0}}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Loc_SummaryFreedSuffix}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentEmeraldBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{DynamicResource AccentEmeraldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3: Active Operation Status -->
                <Border Grid.Column="4"
                        Background="{DynamicResource CardSurfaceGradientBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,13">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding SectionTitle}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBlueBrush}"/>
                            </StackPanel>
                            <Button Style="{StaticResource DangerButtonStyle}"
                                    Content="{DynamicResource Loc_StopOperationBtn}"
                                    Padding="10,3"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="36"
                                   Margin="0,5,0,3"/>
                        <TextBlock Text="{Binding CurrentOperationDetail}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== ROW 1: DYNAMIC MODULE VIEWS ==================== -->
            <Grid Grid.Row="1">
                <!-- 100% Modular Lazy Views Host (57 Lazy Views covering all 60 section keys) -->
                <ContentControl x:Name="LazyModuleHost" Visibility="Collapsed"/>
            </Grid>

                    <!-- ==================== ROW 2: GLOBAL PROGRESS & LIVE LOG FOOTER ==================== -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,9"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Loc_LiveConsoleHeader}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Maximum="100"
                                             Height="5"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center"
                                             Background="{DynamicResource BgCardBrush}"
                                             Foreground="{DynamicResource PrimaryGradientBrush}"
                                             BorderThickness="0"/>
                                <Border Grid.Column="2"
                                        Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="7,2"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Loc_LogFilterHint}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActivityLogFilter}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding ActivityLogFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                                 FontSize="11"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="📋"
                                            AutomationProperties.Name="{DynamicResource Loc_LogCopyTip}"
                                            Padding="6,2"
                                            FontSize="11"
                                            Margin="0,0,4,0"
                                            ToolTip="{DynamicResource Loc_LogCopyTip}"
                                            Command="{Binding CopyActivityLogsCommand}"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="💾"
                                            AutomationProperties.Name="{DynamicResource Loc_LogExportTip}"
                                            Padding="6,2"
                                            FontSize="11"
                                            Margin="0,0,4,0"
                                            ToolTip="{DynamicResource Loc_LogExportTip}"
                                            Command="{Binding ExportActivityLogsCommand}"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="🗑️"
                                            AutomationProperties.Name="{DynamicResource Loc_LogClearTip}"
                                            Padding="6,2"
                                            FontSize="11"
                                            ToolTip="{DynamicResource Loc_LogClearTip}"
                                            Command="{Binding ClearActivityLogsCommand}"/>
                                </StackPanel>
                            </Grid>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding FilteredActivityLogsView}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource AccentBlueBrush}"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="11.5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== CTRL+K QUICK COMMAND PALETTE OVERLAY ==================== -->
            <Grid x:Name="CommandPaletteOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="99"
                  Background="#99000000"
                  Visibility="Collapsed"
                  MouseDown="CommandPaletteBackdrop_MouseDown">
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Width="620"
                        MaxHeight="470"
                        VerticalAlignment="Top"
                        Margin="0,78,0,0"
                        Padding="14"
                        MouseDown="CommandPaletteCard_MouseDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource BgPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,7"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBlueBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource Loc_PalettePlaceholder}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CommandPaletteInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="CommandPaletteInput"
                                         Grid.Column="1"
                                         AutomationProperties.Name="{DynamicResource Loc_PalettePlaceholder}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBlueBrush}"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         TextChanged="CommandPaletteInput_TextChanged"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="CommandPaletteList"
                                 Grid.Row="1"
                                 AutomationProperties.Name="{DynamicResource Loc_CmdPaletteTip}"
                                 Background="{DynamicResource BgPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 MaxHeight="340"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="CommandPaletteList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,5" Width="560">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource AccentBlueBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,2"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource Loc_PaletteFooterHint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,2,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== KEYBOARD SHORTCUTS OVERLAY (F1) ==================== -->
            <Grid x:Name="ShortcutsOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="92"
                  Background="#AA000000"
                  Visibility="Collapsed"
                  MouseDown="ShortcutsBackdrop_MouseDown">
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Width="560"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="22"
                        MouseDown="ShortcutsCard_MouseDown">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Loc_ShortcutsOverlayTitle}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_ShortcutsOverlaySubtitle}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Content="{DynamicResource Loc_ShortcutsCloseBtn}"
                                    AutomationProperties.Name="{DynamicResource Loc_ShortcutsCloseBtn}"
                                    VerticalAlignment="Top"
                                    Padding="10,5"
                                    FontSize="11.5"
                                    Click="CloseShortcutsOverlay_Click"/>
                        </Grid>

                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_Shortcut_CmdPalette}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_Shortcut_Search}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_Shortcut_Settings}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_Shortcut_QuickJump}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_Shortcut_BackForward}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_Shortcut_Refresh}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_Shortcut_Help}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_Shortcut_Escape}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== FIRST-RUN QUICK SETUP OVERLAY ==================== -->
            <Grid x:Name="OnboardingOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="98"
                  Background="#AA000000"
                  Visibility="{Binding ShowOnboardingOverlay, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Width="540"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_OnboardTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Loc_OnboardSubtitle}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource Loc_OnboardLangLabel}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Code"
                                              SelectedValue="{Binding SelectedLanguage}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource Loc_OnboardThemeLabel}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableThemes}"
                                              SelectedItem="{Binding SelectedTheme}"/>
                                </Grid>

                                <CheckBox IsChecked="{Binding UseRecycleBinSafety}"
                                          Content="{DynamicResource Loc_SafetyCheckBox}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,8"/>

                                <CheckBox IsChecked="{Binding IsPortableMode}"
                                          Content="{DynamicResource Loc_SettingsPortableCheck}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource Loc_OnboardShortcutHint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="{DynamicResource Loc_OnboardStartBtn}"
                                AutomationProperties.Name="{DynamicResource Loc_OnboardStartBtn}"
                                Padding="18,10"
                                FontSize="13.5"
                                HorizontalAlignment="Right"
                                Command="{Binding CompleteOnboardingCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== IN-APP TOAST NOTIFICATION OVERLAY ==================== -->
            <Border x:Name="ToastOverlay"
                    Grid.RowSpan="2"
                    Panel.ZIndex="95"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,22,22"
                    MaxWidth="420"
                    MinWidth="300"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentBlueBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="14,12"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ActiveToast.SeverityIcon}"
                               FontSize="16"
                               VerticalAlignment="Top"
                               Margin="0,1,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ActiveToast.Title}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ActiveToast.Message}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{Binding ActiveToast.ActionLabel}"
                                Command="{Binding ExecuteToastActionCommand}"
                                Visibility="{Binding ToastHasAction, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left"
                                Padding="10,4"
                                FontSize="11.5"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource SubtleButtonStyle}"
                            Content="✕"
                            FontSize="11"
                            Padding="6,2"
                            VerticalAlignment="Top"
                            Margin="8,0,0,0"
                            ToolTip="{DynamicResource Loc_ToastDismissTip}"
                            AutomationProperties.Name="{DynamicResource Loc_ToastDismissTip}"
                            Command="{Binding DismissToastCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
