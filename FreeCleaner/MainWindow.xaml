<Window x:Class="FreeCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FreeCleaner.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource Loc_WindowTitle}"
        Icon="Assets/app.ico"
        Height="860"
        Width="1380"
        MinHeight="700"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Background="{DynamicResource BgPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom Modern Fluent Title / Command Bar -->
                <RowDefinition Height="52"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== TOP FLUENT COMMAND & TITLE BAR ==================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                    Padding="16,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Pill + Active Section Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/app.ico"
                               Width="28"
                               Height="28"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="FREECLEANER" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="8,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersionDisplay}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Text="›" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SectionTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Quick Action Bar in Header -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_CmdPaletteBtn}"
                                Padding="9,5"
                                FontSize="11"
                                Margin="0,0,6,0"
                                ToolTip="{DynamicResource Loc_CmdPaletteTip}"
                                Click="OpenCommandPalette_Click"/>

                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{Binding FavoriteButtonText}"
                                Padding="9,5"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Command="{Binding ToggleCurrentFavoriteCommand}"/>

                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AdminStatusBadge, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentEmeraldBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_AdminElevateBtn}"
                                Padding="9,5"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Command="{Binding RestartAsAdminCommand}"
                                Visibility="{Binding IsNotAdmin, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="{DynamicResource Loc_GameModeBtn}"
                                Padding="10,5"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Command="{Binding ActivateGameBoosterCommand}"/>

                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_RamBtn}"
                                Padding="9,5"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Command="{Binding OptimizeRamCommand}"/>

                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_ReportBtn}"
                                Padding="9,5"
                                FontSize="11"
                                Command="{Binding ExportReportsCommand}"/>
                    </StackPanel>

                    <!-- Custom Window Caption Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Simge Durumuna Küçült">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource WindowCaptionButtonStyle}"
                                Click="MaximizeRestoreButton_Click"
                                ToolTip="Ekranı Kapla / Geri Yükle">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Kapat">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN WORKSPACE GRID ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Navigation Sidebar -->
                    <ColumnDefinition Width="286"/>
                    <!-- Main Content Area -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT SIDEBAR ==================== -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBgGradientBrush}"
                        BorderBrush="#1E2B45"
                        BorderThickness="0,0,1,0"
                        Padding="14,12,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Search & Quick Navigation Control Panel -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <Border Background="{DynamicResource BgPrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,7,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource Loc_NavSearchPlaceholder}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NavSearchTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="NavSearchTextBox"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource AccentBlueBrush}"
                                             FontSize="12"
                                             VerticalAlignment="Center"
                                             TextChanged="NavSearchTextBox_TextChanged"/>
                                    <Button x:Name="ClearNavSearchBtn"
                                            Grid.Column="2"
                                            Content="✕"
                                            Visibility="Collapsed"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="11"
                                            Padding="5,1"
                                            Cursor="Hand"
                                            ToolTip="Aramayı Temizle"
                                            Click="ClearNavSearchButton_Click"/>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,7,0,0">
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_ExpandAllBtn}"
                                        Padding="6,5"
                                        FontSize="11"
                                        Margin="0,0,3,4"
                                        Click="ExpandAllNavGroups_Click"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_CollapseAllBtn}"
                                        Padding="6,5"
                                        FontSize="11"
                                        Margin="3,0,0,4"
                                        Click="CollapseAllNavGroups_Click"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_QuickDashboardBtn}"
                                        Padding="6,5"
                                        FontSize="11"
                                        Margin="0,0,3,0"
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="Dashboard"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_QuickLiveBtn}"
                                        Padding="6,5"
                                        FontSize="11"
                                        Margin="3,0,0,0"
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="LiveMonitor"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Navigation Menu (Scrollable Collapsible Category Expanders) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="NavMenuStackPanel">

                                <!-- Pinned Favorites -->
                                <Expander Style="{StaticResource NavCategoryExpanderStyle}"
                                          Header="{DynamicResource Loc_CatFavorites}"
                                          IsExpanded="True">
                                    <ItemsControl ItemsSource="{Binding FavoriteNavItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SubtleButtonStyle}"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="9,6"
                                                        Margin="0,1.5"
                                                        Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SectionKey}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13.5" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!-- 1. Temizlik & Disk Kurtarma (10) -->
                                <Expander Style="{StaticResource NavCategoryExpanderStyle}"
                                          Header="{DynamicResource Loc_CatCleaning}"
                                          IsExpanded="True">
                                    <StackPanel>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsDashboardSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Dashboard">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Genel Bakış (Dashboard)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsDiskTreemapSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="DiskTreemap">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Görsel Disk Haritası (Treemap)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsAllSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="All">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Akıllı Temizlik (Tümü)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsSystemSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="System">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Windows &amp; Sistem" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsBrowsersSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Browsers">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Web Tarayıcıları" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsAppsSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Apps">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Uygulama &amp; Geliştirici" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsDiskAnalyzerSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="DiskAnalyzer">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Büyük &amp; Kopya Dosyalar" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsDownloadsSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Downloads">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="İndirilenler &amp; Boş Klasör" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsBloatwareSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Bloatware">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Bloatware (Appx) Kaldırıcı" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsShredderSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Shredder">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Dosya Öğütücü (DoD)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Expander>

                                <!-- 2. Performans, Açılış & Donanım (9) -->
                                <Expander Style="{StaticResource NavCategoryExpanderStyle}"
                                          Header="{DynamicResource Loc_CatPerformance}"
                                          IsExpanded="True">
                                    <StackPanel>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsLiveMonitorSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="LiveMonitor">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Canlı CPU / RAM &amp; Ağ" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsStartupSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Startup">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Başlangıç Yöneticisi" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsBootPerformanceSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="BootPerformance">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Açılış Süresi (Boot) Analizi" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsBoosterSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Booster">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="RAM &amp; Ağ Hızlandırıcı" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsProcessPrioritySection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="ProcessPriority">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Canlı CPU Önceliği &amp; Eco Mod" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsDiskBenchSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="DiskBench">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="SSD / NVMe Disk Hız Testi" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsSmartPowerSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="SmartPower">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Disk Sağlığı &amp; Güç Planı" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsHardwareSpecsSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="HardwareSpecs">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Donanım, BIOS &amp; Lisans" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsMonitorGpuSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="MonitorGpu">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Monitör (Hz) &amp; GPU Doktoru" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Expander>

                                <!-- 3. Sistem Onarım & Windows 11 (10) -->
                                <Expander Style="{StaticResource NavCategoryExpanderStyle}"
                                          Header="{DynamicResource Loc_CatRepairWin11}"
                                          IsExpanded="False">
                                    <StackPanel>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsWingetUpdaterSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="WingetUpdater">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Winget Program Güncelleyici" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsWin11TweakerSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Win11Tweaker">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Windows 11 İnce Ayar (Tweaker)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsRegistrySection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Registry">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Kayıt Defteri (Registry)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsUninstallerSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Uninstaller">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Programlar &amp; Kalıntılar" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsServicesSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="Services">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE912;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Windows Servisleri" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsRepairCenterSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="RepairCenter">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Sistem Onarım (SFC/DISM)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsRestoreGodModeSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="RestoreGodMode">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Geri Yükleme &amp; God Mode" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                                     IsChecked="{Binding IsContextMenuSection, Mode=OneWay}"
                                                     Command="{Binding SelectSectionCommand}"
                                                     CommandParameter="ContextMenu">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Sağ Tık Menüsü (Shell)" VerticalAlignment="Center"/>
