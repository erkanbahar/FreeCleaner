                                         Foreground="White"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         Padding="6,5"
                                         Margin="0,0,6,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Seç..."
                                        Command="{Binding BrowseEmptyFolderTargetCommand}"
                                        Margin="0,0,6,0"/>
