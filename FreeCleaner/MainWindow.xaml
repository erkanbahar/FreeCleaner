                                    <TextBox Text="{Binding BatchRenameSuffixText, UpdateSourceTrigger=PropertyChanged}" Width="95" Padding="6,4" Background="#0D1422" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Margin="0,0,10,0"/>

