                                <DataGridTextColumn Header="Kayıt Defteri Yolu" Binding="{Binding RegistrySubKeyPath}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!-- VIEW 15: WINDOWS SERVICES & TELEMETRY OPTIMIZER                           -->
                <!-- ========================================================================= -->
