<Window x:Class="FreeCleaner.Dialogs.ThemedDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        MinWidth="380"
        MaxWidth="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1.2"
            CornerRadius="12"
            Padding="0"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Draggable Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Padding="18,12,14,12"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBadgeBorder"
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            CornerRadius="8"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource AccentBlueBrush}"
                            BorderThickness="1.2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyphText"
                                   Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="DialogTitleText"
                               Grid.Column="1"
                               FontSize="14.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="HeaderCloseButton"
                            Grid.Column="2"
                            Style="{StaticResource SubtleButtonStyle}"
                            Content="✕"
                            Padding="8,4"
                            FontSize="11"
                            Click="CloseCancel_Click"/>
                </Grid>
            </Border>

            <!-- Message Body -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="340"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,18">
                <TextBlock x:Name="DialogMessageText"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- Action Buttons Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelActionButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            MinWidth="88"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="CancelActionButton_Click"/>

                    <Button x:Name="SecondaryActionButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            MinWidth="88"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="SecondaryActionButton_Click"/>

                    <Button x:Name="PrimaryActionButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="96"
                            Padding="16,8"
                            Click="PrimaryActionButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
