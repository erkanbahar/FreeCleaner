<UserControl x:Class="FreeCleaner.Views.FontManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SİSTEM &amp; KULLANICI FONT (YAZI TİPİ) YÖNETİCİSİ"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Windows Sistem Fontlarını ve Kullanıcı Fontlarını listeler; seçilen kullanıcı fontlarını Masaüstüne yedekleyerek güvenle kaldırır."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Text="{Binding FontSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Width="175"
                             Padding="8,6"
                             Background="#0D1422"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Fontları Tara"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanInstalledFontsCommand}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Fonts Klasörü"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding OpenWindowsFontsFolderCommand}"/>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="Seçili Kullanıcı Fontlarını Yedekle &amp; Sil"
                            Padding="12,7"
                            Command="{Binding RemoveSelectedUserFontsCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding InstalledFonts}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding SourceCategory}" IsReadOnly="True" Width="210"/>
                    <DataGridTextColumn Header="Yazı Tipi Ailesi" Binding="{Binding FontFamilyGuess}" IsReadOnly="True" Width="195"/>
                    <DataGridTextColumn Header="Dosya Adı" Binding="{Binding FontFileName}" IsReadOnly="True" Width="185"/>
                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" IsReadOnly="True" Width="95"/>
                    <DataGridTextColumn Header="Örnek Türkçe Karakter Metni" Binding="{Binding SamplePreviewText}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>