<UserControl x:Class="FreeCleaner.Views.FontManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_FontTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_FontSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Text="{Binding FontSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Width="175"
                             Padding="8,6"
                             Background="#0D1422"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_FontScanBtn}"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanInstalledFontsCommand}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Loc_M_FontOpenDirBtn}"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding OpenWindowsFontsFolderCommand}"/>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource Loc_M_FontRemoveBtn}"
                            Padding="12,7"
                            Command="{Binding RemoveSelectedUserFontsCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding InstalledFonts}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding SourceCategory}" IsReadOnly="True" Width="210">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColCategory}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FontFamilyGuess}" IsReadOnly="True" Width="195">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_FontNameCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FontFileName}" IsReadOnly="True" Width="185">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DiskColFileName}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedSize}" IsReadOnly="True" Width="95">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding SamplePreviewText}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_FontSampleCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>