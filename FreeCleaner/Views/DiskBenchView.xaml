<UserControl x:Class="FreeCleaner.Views.DiskBenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="CANLI SSD / NVME DİSK OKUMA &amp; YAZMA HIZ TESTİ (DISK BENCHMARK)"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Listeden test etmek istediğiniz SSD / NVMe sürücüyü ve veri bloğu boyutunu seçin; önbelleksiz (WriteThrough) gerçek okuma ve yazma hızını ölçün."
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource CardSurfaceGradientBrush}"
                    BorderBrush="#263859"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="SSD / Sürücü Seçin:"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,10,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableBenchmarkDrives}"
                              SelectedItem="{Binding SelectedBenchmarkDrive, Mode=TwoWay}"
                              DisplayMemberPath="DisplayTitle"
                              Height="34"
                              VerticalContentAlignment="Center"
                              Padding="10,4"
                              Margin="0,0,14,0"/>

                    <TextBlock Grid.Column="2"
                               Text="Test Bloğu (MB):"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding AvailableBenchmarkBlockSizesMb}"
                              SelectedItem="{Binding BenchmarkBlockSizeMb, Mode=TwoWay}"
                              Height="34"
                              VerticalContentAlignment="Center"
                              Padding="8,4"
                              Margin="0,0,10,0"/>

                    <Button Grid.Column="4"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="🔄 Diskleri Yenile"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshBenchmarkDrivesCommand}"/>

                    <Button Grid.Column="5"
                            Style="{StaticResource CleanButtonStyle}"
                            Content="🚀 Seçili SSD Hız Testini Başlat"
                            Padding="16,7"
                            Command="{Binding RunDiskBenchmarkCommand}"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding DiskBenchmarkResults}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Test Zamanı" Binding="{Binding TestedAt}" Width="145"/>
                    <DataGridTextColumn Header="Sürücü" Binding="{Binding DriveName}" Width="85"/>
                    <DataGridTextColumn Header="Test Bloğu (MB)" Binding="{Binding TestBlockSizeMb}" Width="115"/>
                    <DataGridTextColumn Header="Yazma Hızı (Sequential Write)" Binding="{Binding WriteFormatted}" Width="195"/>
                    <DataGridTextColumn Header="Okuma Hızı (Sequential Read)" Binding="{Binding ReadFormatted}" Width="195"/>
                    <DataGridTextColumn Header="Performans Sınıfı" Binding="{Binding PerformanceGrade}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>