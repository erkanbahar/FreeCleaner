<UserControl x:Class="FreeCleaner.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cleaner Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_CleanerSelectAll}"
                            Command="{Binding SelectAllRulesCommand}"
                            Margin="0,0,6,2"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_CleanerDeselectAll}"
                            Command="{Binding DeselectAllRulesCommand}"
                            Margin="0,0,8,2"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_CleanerExportReport}"
                            Command="{Binding ExportReportCommand}"
                            Margin="0,0,10,2"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_ProfileSafeBtn}"
                            Command="{Binding ApplyCleaningProfileCommand}"
                            CommandParameter="SafeDaily"
                            Padding="8,5"
                            FontSize="11.5"
                            Margin="0,0,4,2"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_ProfileDevBtn}"
                            Command="{Binding ApplyCleaningProfileCommand}"
                            CommandParameter="DeveloperDeep"
                            Padding="8,5"
                            FontSize="11.5"
                            Margin="0,0,4,2"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_ProfileGamerBtn}"
                            Command="{Binding ApplyCleaningProfileCommand}"
                            CommandParameter="GamerBoost"
                            Padding="8,5"
                            FontSize="11.5"
                            Margin="0,0,4,2"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_ProfilePrivacyBtn}"
                            Command="{Binding ApplyCleaningProfileCommand}"
                            CommandParameter="MaxPrivacy"
                            Padding="8,5"
                            FontSize="11.5"
                            Margin="0,0,0,2"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AnalyzeCommand}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc_CleanerAnalyzeBtn}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CleanButtonStyle}"
                            Command="{Binding CleanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc_CleanerStartBtn}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cleaner Split Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Rules List -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource Loc_CleanerRulesHeader}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="4,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredRulesView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,4,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,9,0"
                                                      Cursor="Hand"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource AccentBlueBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding RiskLabel}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource WarningAmberBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding FormattedSize}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource AccentEmeraldBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Discovered Files DataGrid -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Loc_CleanerFilesHeader}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableRiskFilters}"
                                  SelectedItem="{Binding RiskFilter, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,8,0"
                                  Padding="6,3"
                                  FontSize="11"
                                  ToolTip="{DynamicResource Loc_CleanerRiskFilterTip}"/>
                        <Border Grid.Column="2"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4">
                            <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBlueBrush}"
                                     BorderThickness="0"
                                     FontSize="12"
                                     ToolTip="{DynamicResource Loc_CleanerSearchFilterTip}"/>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredFilesView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="{DynamicResource BgPrimaryBrush}"
                              RowBackground="{DynamicResource BgSecondaryBrush}"
                              AlternatingRowBackground="{DynamicResource BgCardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                              BorderThickness="1"
                              RowHeight="29"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Binding="{Binding Category}" IsReadOnly="True" Width="135">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_ColCategory}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding RiskLabel}" IsReadOnly="True" Width="85">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_CleanerColRisk}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="90">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Status}" IsReadOnly="True" Width="110">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_ColStatus}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FullPath}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_CleanerColFilePath}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
