<UserControl x:Class="FreeCleaner.Views.BrowserExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="TARAYICI EKLENTİLERİ (EXTENSIONS) DENETÇİSİ"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Chrome, Edge, Brave ve Vivaldi profillerinde kurulu tüm eklentileri (manifest.json) tarar; şüpheli veya gereksiz eklentileri kaldırır."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Eklentileri Yeniden Tara"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanBrowserExtensionsCommand}"/>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="Seçili Eklentileri Kaldır"
                            Padding="12,7"
                            Command="{Binding RemoveSelectedExtensionsCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding BrowserExtensions}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    <DataGridTextColumn Header="Tarayıcı" Binding="{Binding BrowserName}" IsReadOnly="True" Width="125"/>
                    <DataGridTextColumn Header="Profil" Binding="{Binding ProfileName}" IsReadOnly="True" Width="95"/>
                    <DataGridTextColumn Header="Eklenti Adı" Binding="{Binding Name}" IsReadOnly="True" Width="210"/>
                    <DataGridTextColumn Header="Sürüm" Binding="{Binding Version}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Açıklama / Uzantı Kimliği" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                    <DataGridTemplateColumn Header="Klasör" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Konumu Aç"
                                        Padding="8,4"
                                        Command="{Binding DataContext.OpenExtensionFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>