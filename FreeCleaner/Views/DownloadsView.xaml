<UserControl x:Class="FreeCleaner.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="245"/>
        </Grid.RowDefinitions>

        <!-- Downloads Old Installers & Empty Folders -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_DlInstallerAgeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding AvailableInstallerAgeDays}"
                                  SelectedItem="{Binding InstallerMinAgeDays}"
                                  Width="65"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,12,0"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_DlScanInstallersBtn}"
                                Command="{Binding ScanOldInstallersCommand}"
                                Margin="0,0,14,0"/>

                        <TextBlock Text="{DynamicResource Loc_DlEmptyTargetLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding EmptyFolderScanTarget, UpdateSourceTrigger=PropertyChanged}"
                                 Width="185"
                                 Background="{DynamicResource BgCardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 Padding="6,5"
                                 Margin="0,0,6,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_BtnSelectDots}"
                                Command="{Binding BrowseEmptyFolderTargetCommand}"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_DlScanEmptyBtn}"
                                Command="{Binding ScanEmptyFoldersCommand}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_DlCleanSelectedBtn}"
                            Command="{Binding CleanDownloadsAndEmptyCommand}"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding DownloadsAndEmptyItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                            <DataGridCheckBoxColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Binding="{Binding ItemType}" IsReadOnly="True" Width="175">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_DlColType}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="220">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_DlColName}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="105">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FormattedAge}" IsReadOnly="True" Width="155">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_DlColAge}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FullPath}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColFullPath}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Smart Folder Organizer with Undo -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource AccentBlueBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_OrgCardTitle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_OrgCardDesc}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OrganizerSummaryText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBlueBrush}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Text="{Binding OrganizerTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Width="260"
                                 Background="{DynamicResource BgCardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 Padding="7,5"
                                 Margin="0,0,6,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_BtnBrowse}"
                                Command="{Binding BrowseOrganizerFolderCommand}"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_TreemapQuickDownloads}"
                                Command="{Binding SelectOrganizerPresetCommand}"
                                CommandParameter="Downloads"
                                Margin="0,0,4,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_TreemapQuickDesktop}"
                                Command="{Binding SelectOrganizerPresetCommand}"
                                CommandParameter="Desktop"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_OrgPreviewBtn}"
                                Command="{Binding PreviewFolderOrganizeCommand}"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="{DynamicResource Loc_OrgApplyBtn}"
                                Command="{Binding ApplyFolderOrganizeCommand}"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_OrgUndoBtn}"
                                Command="{Binding UndoFolderOrganizeCommand}"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding OrganizerPlanItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="27">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding TargetCategory}" Width="115">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColCategory}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FileName}" Width="240">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_DiskColFileName}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" Width="90">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DestinationPath}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_OrgColDestPath}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
