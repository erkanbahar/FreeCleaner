<UserControl x:Class="FreeCleaner.Views.CredentialSshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_CredTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_CredSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_CredScanBtn}"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanCredentialsAndSshCommand}"/>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource Loc_M_CredDelBtn}"
                            Padding="13,7"
                            Command="{Binding DeleteSelectedCredentialsCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding CredentialsAndSshItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding Category}" IsReadOnly="True" Width="235">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColCategory}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TargetOrKeyName}" IsReadOnly="True" Width="260">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CredTargetCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding UserOrType}" IsReadOnly="True" Width="210">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CredUserCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding DetailsOrPublicKey}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CredDetailsCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="105">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CredCopyCol}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{DynamicResource Loc_M_CredCopyCol}"
                                        Padding="8,3"
                                        FontSize="11"
                                        Command="{Binding DataContext.CopyCredentialOrSshValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>