<UserControl x:Class="FreeCleaner.Views.CredentialSshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="WINDOWS KİMLİK KASASI (CMDKEY) &amp; SSH / GİT ANAHTAR DENETÇİSİ"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Windows Credential Manager üzerinde kayıtlı sunucu/Git hedeflerini ve ~/.ssh klasöründeki açık/özel anahtarları denetler."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="🔑 Kimlik Kasasını &amp; SSH Anahtarlarını Tara"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanCredentialsAndSshCommand}"/>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="🗑️ Seçili Kimlik Kayıtlarını Sil"
                            Padding="13,7"
                            Command="{Binding DeleteSelectedCredentialsCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding CredentialsAndSshItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" IsReadOnly="True" Width="235"/>
                    <DataGridTextColumn Header="Hedef / Anahtar Adı" Binding="{Binding TargetOrKeyName}" IsReadOnly="True" Width="260"/>
                    <DataGridTextColumn Header="Kullanıcı / Konum" Binding="{Binding UserOrType}" IsReadOnly="True" Width="210"/>
                    <DataGridTextColumn Header="Ayrıntılar / SSH Public Key" Binding="{Binding DetailsOrPublicKey}" IsReadOnly="True" Width="*"/>
                    <DataGridTemplateColumn Header="Kopyala" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Kopyala"
                                        Padding="8,3"
                                        FontSize="11"
                                        Command="{Binding DataContext.CopyCredentialOrSshValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>