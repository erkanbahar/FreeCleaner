<UserControl x:Class="FreeCleaner.Views.WingetUpdaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_WingetTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_WingetSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{DynamicResource Loc_WingetScanBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_WingetScanBtn}"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanWingetUpgradesCommand}"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_WingetUpgradeSelBtn}" Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_WingetUpgradeSelBtn}"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Command="{Binding UpgradeSelectedWingetCommand}"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_WingetUpgradeAllBtn}" Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Loc_WingetUpgradeAllBtn}"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding UpgradeAllWingetCommand}"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_WingetCancelBtn}" Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource Loc_WingetCancelBtn}"
                            Padding="12,7"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Live Winget Progress Panel -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding WingetCurrentPackageText}"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,140,0"/>
                        <TextBlock Text="{Binding WingetProgressCounterText}"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource AccentEmeraldBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding WingetProgressPercent, Mode=OneWay}"
                                 Maximum="100"
                                 Height="10"
                                 Background="{DynamicResource BgCardBrush}"
                                 Foreground="{DynamicResource CleanGradientBrush}"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>

            <DataGrid AutomationProperties.Name="{DynamicResource Loc_WingetTitle}" Grid.Row="2"
                      ItemsSource="{Binding WingetUpgrades}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding UpgradeStatus}" IsReadOnly="True" Width="170">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_WingetColStatus}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding PackageName}" IsReadOnly="True" Width="250">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_StartupColAppName}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding PackageId}" IsReadOnly="True" Width="230">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_WingetColId}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding InstalledVersion}" IsReadOnly="True" Width="130">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_WingetColInstalled}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding AvailableVersion}" IsReadOnly="True" Width="130">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_WingetColAvailable}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding SourceName}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_WingetColSource}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
