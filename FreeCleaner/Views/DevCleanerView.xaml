<UserControl x:Class="FreeCleaner.Views.DevCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Visual Studio Debug & Retail Dedicated Auto-Clean Card -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource AccentBlueBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBlueBrush}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc_DevVsTitle}"
                                       FontWeight="Bold"
                                       FontSize="13.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Loc_DevVsSubtitle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding VsIncludeDebug}"
                                      Content="{DynamicResource Loc_DevVsCheckDebug}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontSize="12"
                                      Margin="0,0,16,0"/>
                            <CheckBox IsChecked="{Binding VsIncludeRetailAndRelease}"
                                      Content="{DynamicResource Loc_DevVsCheckRetail}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontSize="12"
                                      Margin="0,0,16,0"/>
                            <CheckBox IsChecked="{Binding VsIncludeObjAndVs}"
                                      Content="{DynamicResource Loc_DevVsCheckObj}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_DevVsScanBtn}"
                                Command="{Binding ScanVsDebugRetailCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="{DynamicResource Loc_DevVsAutoCleanBtn}"
                                Command="{Binding AutoCleanVsDebugRetailCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- General Dev Workspace & Gamer Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_DevWorkspaceLabel}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding DevWorkspacePath, UpdateSourceTrigger=PropertyChanged}"
                             Width="260"
                             Background="{DynamicResource BgCardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             Margin="0,0,6,0"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_SettingsBrowseBtn}"
                            Command="{Binding BrowseDevWorkspaceCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_DevScanAllBtn}"
                            Command="{Binding ScanDevProjectsCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_DevScanGamerBtn}"
                            Command="{Binding ScanGamerCachesCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_DevCleanSelBtn}"
                            Command="{Binding CleanDevArtifactsCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding DevArtifactItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="32">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding ProjectName}" IsReadOnly="True" Width="210">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DevColProject}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ArtifactType}" IsReadOnly="True" Width="150">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DevColType}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="105">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedDate}" IsReadOnly="True" Width="125">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DiskColModified}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FullPath}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_PkgColFolder}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
