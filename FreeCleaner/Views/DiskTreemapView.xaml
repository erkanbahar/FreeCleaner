<UserControl x:Class="FreeCleaner.Views.DiskTreemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="155"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header & Summary Pill -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Loc_TreemapTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_TreemapSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock Text="{Binding TreemapSummaryText}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBlueBrush}"/>
                </Border>
            </Grid>

            <!-- Row 1: Path Bar & Controls -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding TreemapCurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{DynamicResource Loc_A11y_TreemapPathInput}"
                         Background="{DynamicResource BgCardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource AccentBlueBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         Padding="10,7"
                         FontSize="12.5"
                         Margin="0,0,8,0"
                         KeyDown="TreemapPathTextBox_KeyDown"/>
                <Button Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="{DynamicResource Loc_TreemapBrowseBtn}"
                        AutomationProperties.Name="{DynamicResource Loc_TreemapBrowseBtn}"
                        Command="{Binding BrowseTreemapFolderCommand}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="2"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="{DynamicResource Loc_TreemapUpBtn}"
                        AutomationProperties.Name="{DynamicResource Loc_TreemapUpBtn}"
                        Command="{Binding NavigateTreemapParentCommand}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Loc_TreemapScanBtn}"
                        AutomationProperties.Name="{DynamicResource Loc_TreemapScanBtn}"
                        Command="{Binding AnalyzeTreemapCommand}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="{DynamicResource Loc_TreemapOpenFolderBtn}"
                        AutomationProperties.Name="{DynamicResource Loc_TreemapOpenFolderBtn}"
                        Command="{Binding OpenTreemapCurrentFolderCommand}"/>
            </Grid>

            <!-- Row 2: Quick Jump Location Chips & Disk Growth Snapshot Controls -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="💿 C:\"
                            Padding="9,4"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Command="{Binding QuickSelectTreemapPathCommand}"
                            CommandParameter="C"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_TreemapQuickUser}"
                            Padding="9,4"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Command="{Binding QuickSelectTreemapPathCommand}"
                            CommandParameter="User"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_TreemapQuickDownloads}"
                            Padding="9,4"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Command="{Binding QuickSelectTreemapPathCommand}"
                            CommandParameter="Downloads"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_TreemapQuickDesktop}"
                            Padding="9,4"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Command="{Binding QuickSelectTreemapPathCommand}"
                            CommandParameter="Desktop"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_TreemapQuickAppData}"
                            Padding="9,4"
                            FontSize="11"
                            Command="{Binding QuickSelectTreemapPathCommand}"
                            CommandParameter="AppData"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_TreemapSaveSnapBtn}"
                            Padding="10,4"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Command="{Binding SaveTreemapSnapshotCommand}"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_TreemapCompareSnapBtn}"
                            Padding="10,4"
                            FontSize="11"
                            Command="{Binding CompareTreemapSnapshotCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Row 3: Live Scanning Progress & Status Banner -->
            <Border Grid.Row="3"
                    Visibility="{Binding IsTreemapScanning, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource AccentBlueBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBlueBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TreemapScanStatusDetail}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource DangerButtonStyle}"
                                Content="{DynamicResource Loc_TreemapCancelBtn}"
                                Padding="10,4"
                                FontSize="11"
                                Command="{Binding CancelCommand}"/>
                    </Grid>
                    <ProgressBar Grid.Row="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding TreemapScanPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsTreemapIndeterminate, Mode=OneWay}"
                                 Height="7"
                                 Background="{DynamicResource BgPrimaryBrush}"
                                 Foreground="{DynamicResource PrimaryGradientBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Grid.Row="2"
                               Text="{Binding TreemapActiveScanPath}"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,5,0,0"/>
                </Grid>
            </Border>

            <!-- Row 4: Interactive Treemap Canvas -->
            <Border x:Name="TreemapSurfaceBorder"
                    Grid.Row="4"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True"
                    Margin="0,0,0,12"
                    SizeChanged="TreemapSurface_SizeChanged">
                <Grid>
                    <!-- Idle empty hint (hidden while scanning) -->
                    <TextBlock Text="{DynamicResource Loc_TreemapEmptyHint}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding TreemapNodes.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsTreemapScanning}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Centered initial scan overlay before first partial blocks render -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding TreemapNodes.Count}" Value="0"/>
                                            <Condition Binding="{Binding IsTreemapScanning}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{DynamicResource Loc_TreemapScanningOverlay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="6"
                                     Background="{DynamicResource BgCardBrush}"
                                     Foreground="{DynamicResource PrimaryGradientBrush}"
                                     BorderThickness="0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding TreemapNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Background="{Binding FillHex, Converter={StaticResource HexToBrush}}"
                                        CornerRadius="6"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="{Binding ToolTipText}"
                                        MouseLeftButtonUp="TreemapTile_MouseLeftButtonUp">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource Loc_TreemapMenuDrill}" Click="DrillDownMenuItem_Click"/>
                                            <MenuItem Header="{DynamicResource Loc_TreemapMenuExplorer}" Click="OpenExplorerMenuItem_Click"/>
                                            <Separator/>
                                            <MenuItem Header="{DynamicResource Loc_TreemapDeleteBtn}" Click="RecycleTreemapMenuItem_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ClipToBounds="True" Margin="6,4">
                                        <StackPanel VerticalAlignment="Center"
                                                    Visibility="{Binding ShowDetailedLabel, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="#E2E8F0" FontSize="10.5" Margin="0,2,0,0">
                                                <Run Text="{Binding FormattedSize, Mode=OneWay}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding PercentText, Mode=OneWay}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ShowDetailedLabel}" Value="False"/>
                                                                <Condition Binding="{Binding ShowCompactLabel}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Row 5: Disk Growth Snapshot Diff Panel -->
            <Border Grid.Row="5"
                    Visibility="{Binding HasTreemapDiffResults, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource AccentBlueBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,8,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{Binding TreemapDiffSummaryText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_TreemapDiffCloseBtn}"
                                HorizontalAlignment="Right"
                                Padding="8,3"
                                FontSize="11"
                                Command="{Binding ClearTreemapDiffCommand}"/>
                    </Grid>
                    <DataGrid Grid.Row="1"
                              MaxHeight="135"
                              ItemsSource="{Binding TreemapDiffItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="{DynamicResource BgPrimaryBrush}"
                              RowBackground="{DynamicResource BgSecondaryBrush}"
                              AlternatingRowBackground="{DynamicResource BgCardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                              BorderThickness="1"
                              RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding StatusBadge}" Width="95">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_ColStatus}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Name}" Width="210">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_TreemapDiffColName}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FormattedPrevious}" Width="105">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_TreemapDiffColPrev}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FormattedCurrent}" Width="105">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_TreemapDiffColCurr}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FormattedDelta}" Width="115">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_TreemapDiffColDelta}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FullPath}" Width="*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_ColFullPath}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="56">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_TreemapDiffColOpen}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="🔍"
                                                Padding="6,2"
                                                FontSize="11"
                                                Command="{Binding DataContext.OpenTreemapDiffPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Row 6: Compact Detail Table -->
            <DataGrid Grid.Row="6"
                      ItemsSource="{Binding TreemapNodes}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Width="240">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_TreemapColName}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TypeBadge}" Width="110">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_TreemapColType}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedSize}" Width="115">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_TreemapColSize}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding PercentText}" Width="72">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_TreemapColShare}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding AdvisorBadge}" Width="215">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_TreemapColAdvisor}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FullPath}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_TreemapColPath}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="📂"
                                            AutomationProperties.Name="{DynamicResource Loc_TreemapTipDrill}"
                                            Padding="7,2"
                                            FontSize="11"
                                            Margin="0,0,4,0"
                                            ToolTip="{DynamicResource Loc_TreemapTipDrill}"
                                            Command="{Binding DataContext.DrillDownTreemapNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="🔍"
                                            AutomationProperties.Name="{DynamicResource Loc_TreemapTipExplorer}"
                                            Padding="7,2"
                                            FontSize="11"
                                            Margin="0,0,4,0"
                                            ToolTip="{DynamicResource Loc_TreemapTipExplorer}"
                                            Command="{Binding DataContext.OpenTreemapNodeInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource DangerButtonStyle}"
                                            Content="🗑️"
                                            AutomationProperties.Name="{DynamicResource Loc_TreemapDeleteBtn}"
                                            Padding="7,2"
                                            FontSize="11"
                                            IsEnabled="{Binding CanSafeDelete}"
                                            ToolTip="{Binding AdvisorSummary}"
                                            Command="{Binding DataContext.MoveTreemapNodeToRecycleBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
