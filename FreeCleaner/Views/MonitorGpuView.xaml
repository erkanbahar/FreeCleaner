<UserControl x:Class="FreeCleaner.Views.MonitorGpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_MonTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_MonSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_MonScanBtn}"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanMonitorsAndGpuCommand}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Loc_M_MonClearTypeBtn}"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding LaunchSystemToolCommand}"
                            CommandParameter="cttune.exe"/>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource Loc_M_GpuResetBtn}"
                            Padding="13,7"
                            Command="{Binding RestartGpuDriverCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding MonitorAndDisplayItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding DisplayName}" Width="245">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_MonNameCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ResolutionAndDepth}" Width="180">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_MonResCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding RefreshRateInfo}" Width="210">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_MonHzCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding EdidAndDriverInfo}" Width="245">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_MonEdidCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding OptimizationBadge}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_MonStateCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>