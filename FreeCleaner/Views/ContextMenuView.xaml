<UserControl x:Class="FreeCleaner.Views.ContextMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_M_CtxTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Loc_M_CtxSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_CtxRefreshBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_CtxRefreshBtn}"
                            Command="{Binding RefreshContextMenuCommand}"
                            Margin="0,0,8,0"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_CtxRemoveBtn}" Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_M_CtxRemoveBtn}"
                            Command="{Binding DeleteContextMenuCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid AutomationProperties.Name="{DynamicResource Loc_M_CtxTitle}" Grid.Row="1"
                      ItemsSource="{Binding ContextMenuEntries}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="32">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding TargetScope}" IsReadOnly="True" Width="190">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CtxScopeCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="210">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CtxNameCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding HandlerValue}" IsReadOnly="True" Width="260">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CtxCmdCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding RegistrySubKeyPath}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CtxRegCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>