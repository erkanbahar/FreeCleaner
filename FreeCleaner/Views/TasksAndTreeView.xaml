<UserControl x:Class="FreeCleaner.Views.TasksAndTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Scheduled Tasks -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Loc_M_TasksTitle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_M_TaskRefreshBtn}"
                            HorizontalAlignment="Right"
                            Command="{Binding RefreshScheduledTasksCommand}"/>
                </Grid>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ScheduledTasks}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="31">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding TaskName}" Width="180">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_M_TaskNameCol}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Status}" Width="85">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColStatus}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding NextRunTime}" Width="135">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_M_TaskNextCol}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TaskPath}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_M_TaskPathCol}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Folder Space Visualizer -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_M_TreeFolderLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SpaceTreeTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Width="195"
                                 Background="{DynamicResource BgCardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 Padding="6,4"
                                 Margin="0,0,6,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_BtnSelectDots}"
                                Command="{Binding BrowseSpaceTreeFolderCommand}"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_AnalyzeBtn}"
                            Padding="12,5"
                            HorizontalAlignment="Right"
                            Command="{Binding AnalyzeFolderSpaceTreeCommand}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FolderSpaceItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,4,7">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource AccentEmeraldBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"/>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Value="{Binding PercentageOfParent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,6,0,2"
                                                     Background="#222D40"
                                                     Foreground="{DynamicResource AccentBlueBrush}"
                                                     BorderThickness="0"/>
                                        <TextBlock Text="{Binding FullPath}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>