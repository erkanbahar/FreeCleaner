<UserControl x:Class="FreeCleaner.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="260"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_RegistryHeader}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_RegistrySubheader}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_RegistryScanBtn}"
                            Command="{Binding ScanRegistryCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_RegistryBackupOnlyBtn}"
                            Command="{Binding BackupRegistryCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_RegistryRestoreLastBtn}"
                            Command="{Binding RestoreRegistryBackupCommand}"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_RegistryFixBtn}"
                            Command="{Binding FixRegistryCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding RegistryIssues}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="32">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding Category}" IsReadOnly="True" Width="220">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_RegColIssueCat}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ProblemDescription}" IsReadOnly="True" Width="250">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColDescription}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding MissingTarget}" IsReadOnly="True" Width="260">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_RegColMissing}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding KeyPath}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_RegColKeyPath}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="10"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Loc_RegistryBackupsHeader}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Content="{DynamicResource Loc_RegistryRefreshBtn}"
                                    Command="{Binding RefreshBackupsCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Style="{StaticResource CleanButtonStyle}"
                                    Content="{DynamicResource Loc_RegistryRestoreSelBtn}"
                                    Command="{Binding RestoreSelectedBackupCommand}"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding BackupFiles}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="{DynamicResource BgPrimaryBrush}"
                              RowBackground="{DynamicResource BgSecondaryBrush}"
                              AlternatingRowBackground="{DynamicResource BgCardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                              BorderThickness="1"
                              RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Binding="{Binding BackupType}" IsReadOnly="True" Width="90">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_DlColType}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FileName}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_RegColFile}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FormattedDate}" IsReadOnly="True" Width="145">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_RegColDate}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FormattedSize}" IsReadOnly="True" Width="85">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
