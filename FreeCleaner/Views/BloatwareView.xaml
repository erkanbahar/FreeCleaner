<UserControl x:Class="FreeCleaner.Views.BloatwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="WINDOWS 10 / 11 ÖNYÜKLÜ BLOATWARE (UWP / APPX) KALDIRICI"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Standart Program Ekle/Kaldır'da görünmeyen Windows mağaza uygulamalarını (Clipchamp, BingNews, Xbox, Solitaire vb.) listeler ve kaldırır."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Mağaza Paketlerini Yeniden Tara"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanAppxBloatwareCommand}"/>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="Seçili Bloatware Paketlerini Kaldır"
                            Padding="12,7"
                            Command="{Binding RemoveSelectedAppxCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding AppxBloatwareItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="35">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridTextColumn Header="Öneri / Kategori" Binding="{Binding CategoryBadge}" IsReadOnly="True" Width="195"/>
                    <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding Name}" IsReadOnly="True" Width="260"/>
                    <DataGridTextColumn Header="Sürüm" Binding="{Binding Version}" IsReadOnly="True" Width="115"/>
                    <DataGridTextColumn Header="Tam Paket Kimliği (PackageFullName)" Binding="{Binding PackageFullName}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
