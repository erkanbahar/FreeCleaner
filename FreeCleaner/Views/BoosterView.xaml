<UserControl x:Class="FreeCleaner.Views.BoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Booster Quick Action Cards -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <StackPanel>
                <TextBlock Text="HIZLANDIRICI &amp; SİSTEM ARAÇLARI"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="RAM Bellek Boşaltıcı (Working Set Trim)" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Arka planda çalışan uygulamaların kullanmadığı ayrılmış bellek sayfalarını işletim sistemine geri kazandırır."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"/>
                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="RAM Belleği Şimdi Optimize Et"
                                Command="{Binding OptimizeRamCommand}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="DNS &amp; Ağ Önbelleği Temizleyici" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Bozuk DNS çözümleme önbelleğini (ipconfig /flushdns) ve hedef önbelleğini sıfırlayarak bağlantı sorunlarını giderir."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="DNS Önbelleğini Sil"
                                    Command="{Binding FlushDnsCommand}"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Content="Ağ Önbelleğini Sıfırla"
                                    Command="{Binding ResetNetCacheCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Windows Derin Bakım Kısayolları" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="Windows Disk Temizleme (cleanmgr / WinSxS)"
                                Command="{Binding LaunchCleanMgrCommand}"
                                Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="Sistem Geri Yükleme Noktası Yöneticisi"
                                Command="{Binding LaunchSystemRestoreCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Top Memory Consuming Processes -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="EN ÇOK BELLEK (RAM) TÜKETEN İŞLEMLER"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="Listeyi Yenile"
                            HorizontalAlignment="Right"
                            Command="{Binding RefreshTopProcessesCommand}"/>
                </Grid>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding TopMemoryProcesses}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="90"/>
                        <DataGridTextColumn Header="İşlem Adı (Process)" Binding="{Binding ProcessName}" Width="*"/>
                        <DataGridTextColumn Header="Bellek Kullanımı (Working Set)" Binding="{Binding FormattedMemory}" SortMemberPath="WorkingSetBytes" Width="210"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
