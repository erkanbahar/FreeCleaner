<UserControl x:Class="FreeCleaner.Views.BoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Booster Quick Action Cards -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc_BoostSectionTitle}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_BoostRamTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_BoostRamDesc}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"/>
                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="{DynamicResource Loc_BoostRamBtn}"
                                Command="{Binding OptimizeRamCommand}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_BoostDnsTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_BoostDnsDesc}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource Loc_BoostFlushDnsBtn}"
                                    Command="{Binding FlushDnsCommand}"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Content="{DynamicResource Loc_BoostResetNetBtn}"
                                    Command="{Binding ResetNetCacheCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_BoostShortcutsTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_BoostCleanMgrBtn}"
                                Command="{Binding LaunchCleanMgrCommand}"
                                Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_BoostSysRestoreBtn}"
                                Command="{Binding LaunchSystemRestoreCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Top Memory Consuming Processes -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Loc_BoostTopMemTitle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_StartupRefreshBtn}"
                            HorizontalAlignment="Right"
                            Command="{Binding RefreshTopProcessesCommand}"/>
                </Grid>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding TopMemoryProcesses}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ProcessId}" Width="90">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_LiveColPid}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ProcessName}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_BoostColProcess}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FormattedMemory}" SortMemberPath="WorkingSetBytes" Width="210">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_BoostColMem}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
