<UserControl x:Class="FreeCleaner.Views.RepairCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18">
        <StackPanel>
            <TextBlock Text="{DynamicResource Loc_M_RepairTitle}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6"/>
            <TextBlock Text="{Binding RepairCenterStatus}"
                       FontSize="12.5"
                       Foreground="{DynamicResource AccentEmeraldBrush}"
                       Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: DISM Component Store Check -->
                <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_M_RepairDismTitle}" FontWeight="Bold" FontSize="13.5"/>
                        <TextBlock Text="{DynamicResource Loc_M_RepairDismDesc}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14"/>
                        <Button AutomationProperties.Name="{DynamicResource Loc_M_RepairDismBtn}" Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_M_RepairDismBtn}"
                                Command="{Binding RunDismCheckCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: SFC /SCANNOW -->
                <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_M_RepairSfcTitle}" FontWeight="Bold" FontSize="13.5"/>
                        <TextBlock Text="{DynamicResource Loc_M_RepairSfcDesc}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14"/>
                        <Button AutomationProperties.Name="{DynamicResource Loc_M_RepairSfcBtn}" Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_M_RepairSfcBtn}"
                                Command="{Binding LaunchSfcScannowCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: FontCache & Windows.old -->
                <Border Grid.Column="4" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_M_RepairFontTitle}" FontWeight="Bold" FontSize="13.5"/>
                        <TextBlock Text="{DynamicResource Loc_M_RepairFontDesc}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14"/>
                        <Button AutomationProperties.Name="{DynamicResource Loc_M_RepairFontBtn}" Style="{StaticResource CleanButtonStyle}"
                                Content="{DynamicResource Loc_M_RepairFontBtn}"
                                Command="{Binding CleanFontAndWindowsOldCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>