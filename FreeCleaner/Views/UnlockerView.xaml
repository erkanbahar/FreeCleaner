<UserControl x:Class="FreeCleaner.Views.UnlockerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Loc_M_UnlockerTitle}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Loc_M_UnlockerSub}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox AutomationProperties.Name="{DynamicResource Loc_M_UnlockerTitle}" Grid.Column="0"
                         Text="{Binding UnlockerTargetPath, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource BgCardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         BorderThickness="1"
                         Padding="10,7"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"/>

                <Button AutomationProperties.Name="{DynamicResource Loc_M_CryptoPickBtn}" Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource Loc_M_CryptoPickBtn}"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Command="{Binding BrowseUnlockerFileCommand}"/>

                <Button AutomationProperties.Name="{DynamicResource Loc_SettingsBrowseBtn}" Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource Loc_SettingsBrowseBtn}"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Command="{Binding BrowseUnlockerFolderCommand}"/>

                <Button AutomationProperties.Name="{DynamicResource Loc_M_UnlockerFindBtn}" Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Loc_M_UnlockerFindBtn}"
                        Padding="14,7"
                        Command="{Binding ScanLockingProcessesCommand}"/>
            </Grid>

            <DataGrid AutomationProperties.Name="{DynamicResource Loc_M_UnlockerTitle}" Grid.Row="2"
                      ItemsSource="{Binding LockingProcesses}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ProcessId}" Width="80">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_LiveColPid}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ProcessName}" Width="180">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_ProcNameCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ApplicationType}" Width="150">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_UnlockerTypeCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding LockedTargetPath}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_UnlockerTargetCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="150">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_UnlockerColBtn}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{DynamicResource Loc_M_UnlockerKillBtn}" Style="{StaticResource DangerButtonStyle}"
                                        Content="{DynamicResource Loc_M_UnlockerKillBtn}"
                                        Padding="8,4"
                                        Command="{Binding DataContext.KillLockingProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>