<UserControl x:Class="FreeCleaner.Views.ExifScrubberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header & Summary Pill -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Loc_ExifTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_ExifSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource AccentEmeraldBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock Text="{Binding ExifSummaryText}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentEmeraldBrush}"/>
                </Border>
            </Grid>

            <!-- Row 1: Folder Bar & Actions -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding ExifScanFolderPath, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource BgCardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource AccentBlueBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         Padding="10,7"
                         FontSize="12.5"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="{DynamicResource Loc_ExifBrowseBtn}"
                        Command="{Binding BrowseExifFolderCommand}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Loc_ExifScanBtn}"
                        Command="{Binding ScanPhotosExifCommand}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="3"
                        Style="{StaticResource CleanButtonStyle}"
                        Content="{DynamicResource Loc_ExifScrubBtn}"
                        Command="{Binding ScrubSelectedPhotosCommand}"/>
            </Grid>

            <!-- Row 2: Privacy & Optimization Options -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox IsChecked="{Binding ExifIncludeSubfolders}"
                          Content="{DynamicResource Loc_ExifSubfoldersCheck}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,20,0"
                          VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding ExifCreateBackup}"
                          Content="{DynamicResource Loc_ExifBackupCheck}"
                          Foreground="{DynamicResource AccentEmeraldBrush}"
                          FontWeight="SemiBold"
                          Margin="0,0,20,0"
                          VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding ExifOptimizeJpeg}"
                          Content="{DynamicResource Loc_ExifOptimizeJpegCheck}"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Row 3: Scanned Photos Grid -->
            <DataGrid Grid.Row="3"
                      ItemsSource="{Binding PhotoMetadataItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="52">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ExifColSelect}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding FileName}" IsReadOnly="True" Width="190">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ExifColFile}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedSize}" IsReadOnly="True" Width="90">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ExifColSize}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding GpsBadge}" IsReadOnly="True" Width="145">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ExifColGps}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CameraInfo}" IsReadOnly="True" Width="155">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ExifColCamera}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding DateTaken}" IsReadOnly="True" Width="135">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ExifColDate}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding MetadataSummary}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ExifColMeta}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding StatusText}" IsReadOnly="True" Width="165">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ExifColStatus}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="📂"
                                        Padding="8,2"
                                        FontSize="11"
                                        HorizontalAlignment="Center"
                                        ToolTip="{DynamicResource Loc_OpenFileLocationTip}"
                                        Command="{Binding DataContext.OpenPhotoLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
