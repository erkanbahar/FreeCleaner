<UserControl x:Class="FreeCleaner.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hero Health Score Card -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardSurfaceGradientBrush}"
                    BorderBrush="{DynamicResource AccentBlueBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,16"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="92"
                            Height="92"
                            CornerRadius="46"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource AccentEmeraldBrush}"
                            BorderThickness="4"
                            Margin="0,0,20,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HealthScore}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentEmeraldBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="/ 100"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Loc_DashHealthLabel}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Border Background="{DynamicResource BgCardHoverBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,2">
                                <TextBlock Text="{Binding HealthGradeBadge}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBlueBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Loc_DashHeroTitle}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding HealthAdviceText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button AutomationProperties.Name="{DynamicResource Loc_DashHealthBtn}" Grid.Column="2"
                            Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_DashHealthBtn}"
                            Padding="18,12"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Command="{Binding RunOneClickHealthCheckCommand}"/>
                </Grid>
            </Border>

            <!-- Quick Navigation Cards -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,10"
                        Margin="0,0,8,0"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="All">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_DashCardCleanTitle}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentBlueBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_DashCardCleanDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,10"
                        Margin="0,0,8,0"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="LiveMonitor">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_DashCardLiveTitle}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentEmeraldBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_DashCardLiveDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,10"
                        Margin="0,0,8,0"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="WingetUpdater">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_DashCardWingetTitle}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentBlueBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_DashCardWingetDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,10"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="DiskBench">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_DashCardBenchTitle}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentAmberBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_DashCardBenchDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Lifetime Recovered Space, 14-Day Sparkbars & Storage Forecast -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_DashLifetimeTitle}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LifetimeFreedFormatted}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentEmeraldBrush}"
                                   Margin="0,2,0,2"/>
                        <TextBlock Text="{Binding LifetimeSessionsSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource Loc_DashLifetimeChartTitle}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentCleanupBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="72" Margin="2,0" ToolTip="{Binding ToolTipText}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Height="{Binding BarHeight}"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="4,4,2,2"
                                                Background="{DynamicResource CleanGradientBrush}"
                                                Opacity="0.9"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DayLabel}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Border Grid.Column="4"
                            Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11,8"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_DashForecastTitle}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding StorageForecastHeadline}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       Margin="0,4,0,2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StorageForecastDetail}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 5-Step Audit Table -->
            <DataGrid AutomationProperties.Name="{DynamicResource Loc_DashHealthLabel}" Grid.Row="3"
                      ItemsSource="{Binding HealthCheckResults}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Category}" Width="165">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DashColCategory}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CheckName}" Width="265">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DashColCheck}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding StatusBadge}" Width="175">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DashColStatus}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Details}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DashColDetails}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
