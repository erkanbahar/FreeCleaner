<UserControl x:Class="FreeCleaner.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_PrivTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_PrivSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button AutomationProperties.Name="{DynamicResource Loc_PrivScanBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_PrivScanBtn}"
                            Command="{Binding ScanPrivacyTracesCommand}"
                            Margin="0,0,8,0"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_PrivCleanBtn}" Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_PrivCleanBtn}"
                            Command="{Binding CleanPrivacyTracesCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid AutomationProperties.Name="{DynamicResource Loc_PrivTitle}" Grid.Row="1"
                      ItemsSource="{Binding PrivacyTraces}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding Category}" IsReadOnly="True" Width="150">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColCategory}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="280">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_PrivColItem}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding StatusText}" IsReadOnly="True" Width="130">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_PrivColFound}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Description}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColDescription}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
