<UserControl x:Class="FreeCleaner.Views.NetworkAdapterDoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_NetAdpTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_NetAdpSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Loc_M_NetAdpRefreshBtn}"
                        Padding="14,7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshNetworkAdaptersCommand}"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,10">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_M_NetAdpToolsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Loc_M_NetAdpDnsArpBtn}"
                            Padding="12,6"
                            Margin="0,0,10,0"
                            Command="{Binding RunNetworkRepairActionCommand}"
                            CommandParameter="ARP_FLUSH"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_NetAdpDhcpBtn}"
                            Padding="12,6"
                            Margin="0,0,10,0"
                            Command="{Binding RunNetworkRepairActionCommand}"
                            CommandParameter="DHCP_RENEW"/>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource Loc_M_NetAdpWinsockBtn}"
                            Padding="12,6"
                            Command="{Binding RunNetworkRepairActionCommand}"
                            CommandParameter="TCP_WINSOCK_RESET"/>
                </WrapPanel>
            </Border>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding NetworkAdapters}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding StatusBadge}" Width="135">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_NetAdpStateCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding AdapterName}" Width="165">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_NetAdpNameCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Description}" Width="245">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_NetAdpDescCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding MacAddress}" Width="150">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_LanMacCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding IpAndGateway}" Width="240">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_NetAdpIpCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding DnsAndSpeed}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_NetAdpSpeedCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>