<UserControl x:Class="FreeCleaner.Views.FirewallBlockerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_FwTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_FwSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_FwBlockExeBtn}" Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource Loc_M_FwBlockExeBtn}"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Command="{Binding BrowseAndBlockExeFirewallCommand}"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_FwUnblockBtn}" Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_M_FwUnblockBtn}"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Command="{Binding RemoveSelectedFirewallRulesCommand}"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_FwRefreshBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_FwRefreshBtn}"
                            Padding="12,7"
                            Command="{Binding RefreshFirewallRulesCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid AutomationProperties.Name="{DynamicResource Loc_M_FwTitle}" Grid.Row="1"
                      ItemsSource="{Binding FirewallBlockRules}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding RuleName}" IsReadOnly="True" Width="250">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_FwRuleCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Direction}" IsReadOnly="True" Width="175">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_FwDirCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ActionBadge}" IsReadOnly="True" Width="195">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColStatus}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ProfileText}" IsReadOnly="True" Width="125">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_ExtProfCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ProgramPath}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_FwPathCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>