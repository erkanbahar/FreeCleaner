<UserControl x:Class="FreeCleaner.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Installed Apps List -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="YÜKLÜ PROGRAMLAR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Text="{Binding AppSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180"
                                 Background="{DynamicResource BgCardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 Padding="6,4"
                                 ToolTip="Program ara..."/>
                    </StackPanel>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="Yenile"
                            HorizontalAlignment="Right"
                            Command="{Binding RefreshInstalledAppsCommand}"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredInstalledAppsView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="33">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="Yayımcı" Binding="{Binding Publisher}" Width="130"/>
                        <DataGridTextColumn Header="Sürüm" Binding="{Binding DisplayVersion}" Width="80"/>
                        <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="EstimatedSizeBytes" Width="85"/>
                        <DataGridTemplateColumn Header="Kaldır" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="Kaldır"
                                            Padding="8,3"
                                            Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Orphan AppData Folders -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YETİM (ORPHAN) APPDATA KLASÖRLERİ" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Kaldırılmış programlardan kalan eski klasörler" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Kalıntı Tara"
                                Padding="12,7"
                                Command="{Binding ScanOrphanFoldersCommand}"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="Seçilileri Sil"
                                Padding="12,7"
                                Command="{Binding CleanOrphanFoldersCommand}"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding OrphanFolders}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="31">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                        <DataGridTextColumn Header="Klasör Adı" Binding="{Binding FolderName}" IsReadOnly="True" Width="135"/>
                        <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="85"/>
                        <DataGridTextColumn Header="Konum" Binding="{Binding FullPath}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
