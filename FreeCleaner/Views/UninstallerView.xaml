<UserControl x:Class="FreeCleaner.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Installed Apps List -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_UninstAppsTitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Text="{Binding AppSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180"
                                 Background="{DynamicResource BgCardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 Padding="6,4"
                                 ToolTip="{DynamicResource Loc_UninstSearchTip}"/>
                    </StackPanel>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_BtnRefresh}"
                            HorizontalAlignment="Right"
                            Command="{Binding RefreshInstalledAppsCommand}"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredInstalledAppsView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="33">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding DisplayName}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_StartupColAppName}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Publisher}" Width="130">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_UninstColPub}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DisplayVersion}" Width="80">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_BloatColVer}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FormattedSize}" SortMemberPath="EstimatedSizeBytes" Width="85">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="85">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_UninstColBtn}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="{DynamicResource Loc_UninstColBtn}"
                                            Padding="8,3"
                                            Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Orphan AppData Folders -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_UninstOrphanTitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_UninstOrphanSubtitle}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_UninstScanOrphanBtn}"
                                Padding="12,7"
                                Command="{Binding ScanOrphanFoldersCommand}"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="{DynamicResource Loc_UninstCleanOrphanBtn}"
                                Padding="12,7"
                                Command="{Binding CleanOrphanFoldersCommand}"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding OrphanFolders}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="31">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                            <DataGridCheckBoxColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Binding="{Binding FolderName}" IsReadOnly="True" Width="135">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_UninstColFolder}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="85">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FullPath}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_StartupColLocation}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
