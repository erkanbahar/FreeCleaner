<UserControl x:Class="FreeCleaner.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_DiskTargetFolder}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBox AutomationProperties.Name="{DynamicResource Loc_DiskTargetFolder}" Text="{Binding DiskScanTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                             Width="250"
                             Background="{DynamicResource BgCardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             Margin="0,0,6,0"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_DiskBrowseBtn}" Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_DiskBrowseBtn}"
                            Command="{Binding BrowseDiskFolderCommand}"
                            Margin="0,0,12,0"/>

                    <TextBlock Text="{DynamicResource Loc_DiskMinSize}" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                    <ComboBox AutomationProperties.Name="{DynamicResource Loc_DiskTargetFolder}" ItemsSource="{Binding AvailableSizeThresholdsMb}"
                              SelectedItem="{Binding SelectedMinSizeMb}"
                              Width="72"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{DynamicResource Loc_DiskFindLargeBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_DiskFindLargeBtn}"
                            Command="{Binding ScanLargeFilesCommand}"
                            Margin="0,0,8,0"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_DiskFindDupBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_DiskFindDupBtn}"
                            Command="{Binding ScanDuplicatesCommand}"
                            Margin="0,0,8,0"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_DiskHardlinkTip}" Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_HardlinkMergeBtn}"
                            ToolTip="{DynamicResource Loc_DiskHardlinkTip}"
                            Command="{Binding MergeDuplicatesWithHardlinksCommand}"
                            Margin="0,0,8,0"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_DiskDeleteSelBtn}" Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_DiskDeleteSelBtn}"
                            Command="{Binding DeleteSelectedDiskFilesCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid AutomationProperties.Name="{DynamicResource Loc_DiskTargetFolder}" Grid.Row="1"
                      ItemsSource="{Binding DiskAnalyzerItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="31"
                      MouseDoubleClick="DiskDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding TypeBadge}" IsReadOnly="True" Width="135">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DiskColTypeDup}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" IsReadOnly="True" Width="105">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FileName}" IsReadOnly="True" Width="210">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DiskColFileName}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedDate}" IsReadOnly="True" Width="125">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DiskColModified}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FullPath}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DiskColFullPathHint}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
