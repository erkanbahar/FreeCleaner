<UserControl x:Class="FreeCleaner.Views.PackageCachesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_PkgTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_PkgSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_PkgScanBtn}"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanPackageCachesCommand}"/>
                    <Button Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_PkgCleanBtn}"
                            Padding="12,7"
                            Command="{Binding CleanPackageCachesCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding GlobalPackageCaches}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Seç" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridTextColumn Header="Ekosistem" Binding="{Binding Ecosystem}" IsReadOnly="True" Width="170"/>
                    <DataGridTextColumn Header="Önbellek / Sanal Disk Adı" Binding="{Binding CacheName}" IsReadOnly="True" Width="225"/>
                    <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Güvenlik Türü" Binding="{Binding SafetyLabel}" IsReadOnly="True" Width="210"/>
                    <DataGridTextColumn Header="Tam Klasör / Dosya Yolu" Binding="{Binding FolderPath}" IsReadOnly="True" Width="*"/>
                    <DataGridTemplateColumn Header="İşlem" Width="195">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{DynamicResource Loc_PkgCompactBtn}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,5,0"
                                            Visibility="{Binding IsVhdxVirtualDisk, Converter={StaticResource BoolToVis}}"
                                            ToolTip="DiskPart compact vdisk ile .vhdx boş bloklarını sıkıştırır (Yönetici + kapalı uygulama gerekir)"
                                            Command="{Binding DataContext.CompactVhdxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{DynamicResource Loc_PkgOpenFolderBtn}"
                                            Padding="8,4"
                                            Command="{Binding DataContext.OpenPackageCacheFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
