<UserControl x:Class="FreeCleaner.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Whitelist / Exclusions Manager -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Loc_SettingsWhitelistTitle}"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_SettingsWhitelistDesc}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewExclusionInput, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BgCardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBlueBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             Padding="8,6"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_SettingsAddBtn}"
                            Padding="14,6"
                            Command="{Binding AddExclusionCommand}"
                            Margin="0,0,6,0"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_SettingsBrowseBtn}"
                            Command="{Binding BrowseExclusionFolderCommand}"/>
                </Grid>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding ExcludedPaths}"
                         Background="{DynamicResource BgPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="12.5"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsRemoveBtn}"
                                        Padding="8,2"
                                        Margin="12,0,0,0"
                                        Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Automation & Reports Panel -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_SettingsRightHeader}"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SettingsThemeLangTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_SettingsThemeLangDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Loc_SettingsThemeLabel}" Width="95" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          Width="210"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Loc_SettingsLangLabel}" Width="95" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Code"
                                          SelectedValue="{Binding SelectedLanguage}"
                                          Width="210"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- App Version & GitHub Releases Update Checker -->
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource Loc_SettingsUpdateTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding AppVersionDisplay}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{DynamicResource Loc_SettingsUpdateDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8"/>
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentEmeraldBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsCheckUpdateBtn}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        Margin="0,0,6,6"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsDownloadUpdateBtn}"
                                        Command="{Binding DownloadAndInstallUpdateCommand}"
                                        IsEnabled="{Binding CanDownloadUpdate}"
                                        Margin="0,0,6,6"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsOpenReleasesBtn}"
                                        Command="{Binding OpenLatestReleasePageCommand}"
                                        Margin="0,0,0,6"/>
                            </WrapPanel>
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,4,0,0"
                                         Value="{Binding UpdateDownloadPercent}"
                                         Foreground="{DynamicResource AccentBlueBrush}"
                                         Background="{DynamicResource BgPrimaryBrush}"
                                         Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding AutoMonitorEnabled}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      FontSize="13"
                                      Content="{DynamicResource Loc_SettingsAutoMonCheck}"/>
                            <TextBlock Text="{DynamicResource Loc_SettingsAutoMonDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Loc_SettingsThresholdLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding AvailableSizeThresholdsMb}"
                                          SelectedItem="{Binding AutoMonitorThresholdMb}"
                                          Width="90"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding MinimizeToTrayOnClose}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      FontSize="12.5"
                                      Content="{DynamicResource Loc_SettingsTrayCheck}"
                                      Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding StartMinimizedWithWindows}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      FontSize="12.5"
                                      Content="{DynamicResource Loc_SettingsAutoStartTrayCheck}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding ScheduledMaintenanceEnabled}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      FontSize="13"
                                      Content="{DynamicResource Loc_SettingsSchedCheck}"/>
                            <TextBlock Text="{DynamicResource Loc_SettingsSchedDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Loc_SettingsIntervalLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding AvailableMaintenanceIntervalsHours}"
                                          SelectedItem="{Binding ScheduledMaintenanceIntervalHours}"
                                          Width="90"/>
                                <TextBlock Text="{DynamicResource Loc_SettingsHoursSuffix}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsInstallTaskBtn}"
                                        Command="{Binding InstallScheduledMaintenanceCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsRemoveTaskBtn}"
                                        Command="{Binding RemoveScheduledMaintenanceCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SettingsReportTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_SettingsReportDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource Loc_SettingsExportReportBtn}"
                                    Command="{Binding ExportReportCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SettingsShellTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_SettingsShellDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8"/>
                            <TextBlock Text="{Binding ExplorerContextMenuStatusText}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsShellInstallBtn}"
                                        Command="{Binding InstallExplorerContextMenuCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsShellRemoveBtn}"
                                        Command="{Binding RemoveExplorerContextMenuCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SettingsBackupTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_SettingsBackupDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsExportCfgBtn}"
                                        Command="{Binding ExportSettingsConfigCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="{DynamicResource Loc_SettingsImportCfgBtn}"
                                        Command="{Binding ImportSettingsConfigCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_SettingsPortableTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_SettingsPortableDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8"/>
                            <CheckBox IsChecked="{Binding IsPortableMode}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      FontSize="12.5"
                                      Content="{DynamicResource Loc_SettingsPortableCheck}"
                                      Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ActiveDataDirectoryDisplay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource Loc_SettingsSupportBundleBtn}"
                                    Command="{Binding ExportSupportBundleCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
