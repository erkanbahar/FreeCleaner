<UserControl x:Class="FreeCleaner.Views.DeepSpaceRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header & Scan Action -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Loc_DeepSpaceTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_DeepSpaceSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource AccentEmeraldBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding DeepSpaceSummaryText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentEmeraldBrush}"/>
                    </Border>
                    <Button AutomationProperties.Name="{DynamicResource Loc_DeepSpaceScanBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_DeepSpaceScanBtn}"
                            Command="{Binding ScanDeepSpaceCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Deep System Storage Opportunities DataGrid -->
            <DataGrid AutomationProperties.Name="{DynamicResource Loc_DeepSpaceTitle}" Grid.Row="1"
                      ItemsSource="{Binding DeepSpaceItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Category}" Width="195">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DeepSpaceColCategory}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Title}" Width="290">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DeepSpaceColTitle}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedSize}" Width="105">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DeepSpaceColSize}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding StatusBadge}" Width="230">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DeepSpaceColStatus}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DeepSpaceColDesc}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{Binding ActionLabel}" Style="{StaticResource CleanButtonStyle}"
                                        Content="{Binding ActionLabel}"
                                        Padding="10,4"
                                        FontSize="11"
                                        HorizontalAlignment="Center"
                                        IsEnabled="{Binding CanExecuteAction}"
                                        Command="{Binding DataContext.ExecuteDeepSpaceItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
