<UserControl x:Class="FreeCleaner.Views.Win11TweakerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_TweakTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_TweakSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_TweakRestartExpBtn}" Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_M_TweakRestartExpBtn}"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Command="{Binding RestartExplorerNowCommand}"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_TweakRefreshBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_TweakRefreshBtn}"
                            Padding="12,7"
                            Command="{Binding RefreshWindowsTweaksCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid AutomationProperties.Name="{DynamicResource Loc_M_TweakTitle}" Grid.Row="1"
                      ItemsSource="{Binding WindowsTweaks}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Category}" Width="195">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColCategory}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Title}" Width="290">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_TweakTitleCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CurrentStateText}" Width="230">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_TweakStateCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColDescription}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="155">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_ClipActionCol}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{DynamicResource Loc_M_TweakToggleBtn}" Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Loc_M_TweakToggleBtn}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Command="{Binding DataContext.ToggleWindowsTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>