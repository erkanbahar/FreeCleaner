<UserControl x:Class="FreeCleaner.Views.CryptoVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_CryptoTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_CryptoSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Loc_M_CryptoFileLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding VaultTargetFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource Loc_M_CryptoFileLabel}"
                                 Width="380"
                                 Padding="8,5"
                                 Background="{DynamicResource BgPrimaryBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource Loc_M_CryptoPickBtn}"
                                AutomationProperties.Name="{DynamicResource Loc_M_CryptoPickBtn}"
                                Padding="12,5"
                                Margin="0,0,10,0"
                                Command="{Binding BrowseVaultTargetFileCommand}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_M_CryptoHashBtn}"
                                AutomationProperties.Name="{DynamicResource Loc_M_CryptoHashBtn}"
                                Padding="14,5"
                                Command="{Binding ComputeMultiHashesCommand}"/>
                    </WrapPanel>

                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Loc_M_CryptoPassLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <PasswordBox x:Name="VaultPasswordBox"
                                     AutomationProperties.Name="{DynamicResource Loc_M_CryptoPassLabel}"
                                     Width="165"
                                     Padding="7,5"
                                     Background="{DynamicResource BgPrimaryBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBlueBrush}"
                                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     Margin="0,0,4,0"
                                     PasswordChanged="VaultPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="VaultPasswordPlainBox"
                                 Text="{Binding VaultPasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource Loc_M_CryptoPassLabel}"
                                 Visibility="Collapsed"
                                 Width="165"
                                 Padding="7,5"
                                 Background="{DynamicResource BgPrimaryBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBlueBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 Margin="0,0,4,0"/>
                        <Button x:Name="ToggleVaultPasswordVisibilityBtn"
                                Style="{StaticResource SubtleButtonStyle}"
                                Content="👁"
                                Padding="8,4"
                                FontSize="11.5"
                                ToolTip="{DynamicResource Loc_CryptoTogglePassTip}"
                                AutomationProperties.Name="{DynamicResource Loc_CryptoTogglePassTip}"
                                Margin="0,0,8,0"
                                Click="ToggleVaultPasswordVisibility_Click"/>
                        <Button Style="{StaticResource CleanButtonStyle}"
                                Content="{DynamicResource Loc_M_CryptoEncBtn}"
                                AutomationProperties.Name="{DynamicResource Loc_M_CryptoEncBtn}"
                                Padding="12,5"
                                Margin="0,0,8,0"
                                Command="{Binding EncryptVaultFileCommand}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_M_CryptoDecBtn}"
                                AutomationProperties.Name="{DynamicResource Loc_M_CryptoDecBtn}"
                                Padding="12,5"
                                Margin="0,0,16,0"
                                Command="{Binding DecryptVaultFileCommand}"/>

                        <TextBlock Text="{DynamicResource Loc_M_CryptoExpectedLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ExpectedHashInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource Loc_M_CryptoExpectedLabel}"
                                 Width="210"
                                 Padding="7,5"
                                 Background="{DynamicResource BgPrimaryBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                    </WrapPanel>

                    <WrapPanel VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Loc_CryptoStrengthLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ProgressBar Width="110"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding VaultPasswordStrengthScore, Mode=OneWay}"
                                     Foreground="{Binding VaultPasswordStrengthHex, Converter={StaticResource HexToBrush}}"
                                     Background="{DynamicResource BgCardBrush}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding VaultPasswordStrengthLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding VaultPasswordStrengthHex, Converter={StaticResource HexToBrush}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,18,0"/>
                        <CheckBox IsChecked="{Binding AutoClearVaultPassword}"
                                  Content="{DynamicResource Loc_CryptoAutoClearPassCheck}"
                                  AutomationProperties.Name="{DynamicResource Loc_CryptoAutoClearPassCheck}"
                                  FontSize="11.5"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding CryptoVaultResults}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding AlgorithmOrOperation}" Width="185">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CryptoAlgoCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FileName}" Width="190">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_DiskColFileName}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding HashOrOutputValue}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CryptoOutCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding VerificationStatus}" Width="245">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CryptoVerifyCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="105">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_CredCopyCol}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{DynamicResource Loc_M_CredCopyCol}"
                                        Padding="8,3"
                                        FontSize="11"
                                        Command="{Binding DataContext.CopyHashValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>