<UserControl x:Class="FreeCleaner.Views.ShredderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Shredder Queue -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_ShredAddFileBtn}"
                                Command="{Binding AddShredFilesCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_ShredAddFolderBtn}"
                                Command="{Binding AddShredFolderCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="{DynamicResource Loc_ShredClearBtn}"
                                Command="{Binding ClearShredQueueCommand}"
                                Margin="0,0,14,0"/>
                        <TextBlock Text="{DynamicResource Loc_ShredPassesLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding AvailableShredPasses}"
                                  SelectedItem="{Binding ShredPassesCount}"
                                  Width="65"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource CleanButtonStyle}"
                            Background="{DynamicResource DangerRedBrush}"
                            Content="{DynamicResource Loc_ShredExecuteBtn}"
                            HorizontalAlignment="Right"
                            Command="{Binding ExecuteShredderCommand}"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ShredQueueItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Width="210">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ShredColName}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FormattedSize}" Width="100">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColSize}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Status}" Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColStatus}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FullPath}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColFullPath}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Free Space Wiper Card -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc_ShredWipeHeader}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_ShredWipeTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Loc_ShredWipeDesc}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Loc_ShredWipeSizeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding AvailableSizeThresholdsMb}"
                                      SelectedItem="{Binding FreeSpaceWipeMb}"
                                      Width="90"/>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Loc_ShredWipeBtn}"
                                Command="{Binding WipeFreeSpaceCommand}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource DangerRedBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_ShredDodTitle}" FontWeight="SemiBold" Foreground="{DynamicResource DangerRedBrush}" FontSize="12.5"/>
                        <TextBlock Text="{DynamicResource Loc_ShredDodDesc}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
