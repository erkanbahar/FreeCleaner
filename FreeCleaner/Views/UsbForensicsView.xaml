<UserControl x:Class="FreeCleaner.Views.UsbForensicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_UsbTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_UsbSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_UsbScanBtn}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_UsbScanBtn}"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanUsbHistoryCommand}"/>
                    <Button AutomationProperties.Name="{DynamicResource Loc_M_UsbCleanBtn}" Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource Loc_M_UsbCleanBtn}"
                            Padding="12,7"
                            Command="{Binding CleanUsbHistoryCommand}"/>
                </StackPanel>
            </Grid>

            <DataGrid AutomationProperties.Name="{DynamicResource Loc_M_UsbTitle}" Grid.Row="1"
                      ItemsSource="{Binding UsbHistoryItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding FriendlyName}" IsReadOnly="True" Width="240">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_UsbNameCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding VendorAndProduct}" IsReadOnly="True" Width="250">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_UsbVendorCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding SerialNumber}" IsReadOnly="True" Width="220">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_UsbSerialCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding RegistrySubKeyPath}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_RegColKeyPath}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>