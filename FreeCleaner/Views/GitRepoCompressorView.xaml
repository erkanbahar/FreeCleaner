<UserControl x:Class="FreeCleaner.Views.GitRepoCompressorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_M_GitTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_M_GitSub}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_M_GitScanBtn}"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Command="{Binding ScanGitReposCommand}"/>
                    <Button Style="{StaticResource CleanButtonStyle}"
                            Content="{DynamicResource Loc_M_GitGcBtn}"
                            Padding="14,7"
                            Command="{Binding CompressSelectedGitReposCommand}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_M_GitRootLabel}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding GitWorkspacePath, UpdateSourceTrigger=PropertyChanged}"
                             Width="390"
                             Padding="8,5"
                             Background="#0D1422"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Loc_AiBrowseScanBtn}"
                            Padding="12,5"
                            Command="{Binding BrowseGitWorkspaceCommand}"/>
                </WrapPanel>
            </Border>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding GitRepoItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource BgPrimaryBrush}"
                      RowBackground="{DynamicResource BgSecondaryBrush}"
                      AlternatingRowBackground="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}"
                      BorderThickness="1"
                      RowHeight="36">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Binding="{Binding RepoName}" IsReadOnly="True" Width="210">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_GitRepoCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ActiveBranch}" IsReadOnly="True" Width="165">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_GitBranchCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding WorkingTreeStatus}" IsReadOnly="True" Width="220">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_GitStatusCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FormattedGitSize}" IsReadOnly="True" Width="120">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_GitSizeCol}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding RepoRootPath}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_PkgColFolder}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="95">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource Loc_M_FolderCol}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{DynamicResource Loc_TreemapDiffColOpen}"
                                        Padding="10,3"
                                        FontSize="11"
                                        Command="{Binding DataContext.OpenGitRepoFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>