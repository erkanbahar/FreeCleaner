<UserControl x:Class="FreeCleaner.Views.SimilarPhotoFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header & Summary -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Loc_SimilarTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_SimilarSubtitle}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock Text="{Binding SimilarPhotosSummaryText}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBlueBrush}"/>
                </Border>
            </Grid>

            <!-- Row 1: Folder Picker & Actions -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SimilarPhotosFolderPath, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource BgCardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource AccentBlueBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         Padding="10,7"
                         FontSize="12.5"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="{DynamicResource Loc_SimilarBrowseBtn}"
                        Command="{Binding BrowseSimilarPhotosFolderCommand}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Loc_SimilarScanBtn}"
                        Command="{Binding ScanSimilarPhotosCommand}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="3"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="{DynamicResource Loc_SimilarCleanBtn}"
                        Command="{Binding CleanSelectedSimilarPhotosCommand}"/>
            </Grid>

            <!-- Row 2: Sensitivity & Subfolder Options -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox IsChecked="{Binding SimilarPhotosIncludeSubfolders}"
                          Content="{DynamicResource Loc_ExifSubfoldersCheck}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"/>
                <TextBlock Text="{DynamicResource Loc_SimilarSensitivityLabel}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AvailableSimilarSensitivities}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="MaxDistance"
                          SelectedValue="{Binding SimilarPhotosMaxDistance}"
                          Width="220"/>
            </StackPanel>

            <!-- Row 3: Similar Groups Grid + Non-Locking Preview Pane -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding SimilarPhotoItems}"
                          SelectedItem="{Binding SelectedSimilarPhoto}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="34"
                          SelectionChanged="SimilarGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50">
                            <DataGridCheckBoxColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColSelect}"/>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Binding="{Binding GroupLabel}" IsReadOnly="True" Width="130">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_SimilarColGroup}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FileName}" IsReadOnly="True" Width="170">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_SimilarColFile}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ResolutionText}" IsReadOnly="True" Width="95">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_SimilarColRes}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding FormattedSize}" IsReadOnly="True" Width="85">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_TreemapColSize}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding SimilarityText}" IsReadOnly="True" Width="105">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_SimilarColSim}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RoleBadge}" IsReadOnly="True" Width="145">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_SimilarColRole}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding StatusText}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_SimilarColStatus}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Content="📂"
                                            Padding="7,2"
                                            FontSize="11"
                                            HorizontalAlignment="Center"
                                            ToolTip="{DynamicResource Loc_OpenFileLocationTip}"
                                            Command="{Binding DataContext.OpenSimilarPhotoLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Safe Non-Locking Preview Card -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource Loc_SimilarPreviewTitle}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <Border Grid.Row="1"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">
                            <Image x:Name="PreviewImageControl"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock x:Name="PreviewFileNameText"
                                       Text="-"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewDetailsText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
