<UserControl x:Class="FreeCleaner.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Active TCP/UDP Connections -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Loc_NetConnTitle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_NetConnRefreshBtn}"
                            AutomationProperties.Name="{DynamicResource Loc_NetConnRefreshBtn}"
                            Padding="12,6"
                            HorizontalAlignment="Right"
                            Command="{Binding RefreshConnectionsCommand}"/>
                </Grid>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ActiveConnections}"
                          AutomationProperties.Name="{DynamicResource Loc_NetConnTitle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Protocol}" Width="65">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_NetColProto}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ProcessName}" Width="140">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_NetColProcess}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ProcessId}" Width="60">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_LiveColPid}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding LocalAddress}" Width="145">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_NetColLocal}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RemoteAddress}" Width="145">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_NetColRemote}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding State}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColStatus}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Windows Hosts File Manager -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Loc_NetHostsTitle}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_BtnRefresh}"
                            HorizontalAlignment="Right"
                            Command="{Binding RefreshHostsCommand}"
                            Margin="0,0,84,0"/>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource Loc_NetHostsRestoreBtn}"
                            HorizontalAlignment="Right"
                            Command="{Binding RestoreHostsBackupCommand}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewHostIp, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{DynamicResource Loc_NetHostIpTip}"
                             Background="{DynamicResource BgCardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBlueBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             Padding="6,5"
                             Margin="0,0,6,0"
                             ToolTip="{DynamicResource Loc_NetHostIpTip}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding NewHostDomain, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{DynamicResource Loc_NetHostDomainTip}"
                             Background="{DynamicResource BgCardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBlueBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}"
                             Padding="6,5"
                             Margin="0,0,6,0"
                             ToolTip="{DynamicResource Loc_NetHostDomainTip}"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Loc_NetHostAddBtn}"
                            AutomationProperties.Name="{DynamicResource Loc_NetHostAddBtn}"
                            Padding="12,5"
                            Command="{Binding AddHostEntryCommand}"/>
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding HostsEntries}"
                          AutomationProperties.Name="{DynamicResource Loc_NetHostsTitle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource BgPrimaryBrush}"
                          RowBackground="{DynamicResource BgSecondaryBrush}"
                          AlternatingRowBackground="{DynamicResource BgCardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1"
                          RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="48">
                            <DataGridCheckBoxColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_NetHostsColEnabled}"/>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Width="105">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_NetHostsColIp}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" Width="165">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_NetHostsColHost}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColDescription}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="140">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Loc_ColActions}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="{DynamicResource Loc_NetHostSaveBtn}"
                                                Padding="6,3"
                                                Margin="0,0,5,0"
                                                Command="{Binding DataContext.SaveHostEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="{DynamicResource Loc_StartupDeleteBtn}"
                                                Padding="6,3"
                                                Command="{Binding DataContext.DeleteHostEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
